    "check:release": "npm run data:check && npm run test:unit && npm run build && GIDPS_PREBUILT=1 npm run test:e2e:calculator",
    "check:workspace": "node scripts/check-workspace-resolution.mjs",
    "pretest:unit": "npm run check:workspace",
    "typecheck": "npm run check:workspace && tsc --noEmit",
    "check": "npm run data:check && npm run typecheck && npm test && npm run build",
    "data:discover": "node packages/game-data/scripts/update-data.mjs discover",
    "data:sync:candidate": "node packages/game-data/scripts/sync-genshin-db-candidate.mjs",
    "data:sync": "node packages/game-data/scripts/update-data.mjs sync",
    "data:normalize": "node packages/game-data/scripts/update-data.mjs normalize",
    "data:classify": "node packages/game-data/scripts/update-data.mjs classify",
    "data:validate": "node packages/game-data/scripts/update-data.mjs validate",
    "data:diff": "node packages/game-data/scripts/update-data.mjs diff",
    "data:promote": "node packages/game-data/scripts/update-data.mjs promote",
    "data:activate": "node packages/game-data/scripts/update-data.mjs activate",
    "data:rollback": "node packages/game-data/scripts/update-data.mjs rollback",
    "data:preview": "node packages/game-data/scripts/update-data.mjs preview",
    "data:status": "node packages/game-data/scripts/update-data.mjs status --write",
    "source:build": "node packages/source-host/scripts/build-source-host.mjs",
    "source:prepare": "node packages/source-host/scripts/prepare-source.mjs",
    "source:build:stellar": "node packages/source-host/stellar-overlay/build.mjs",
    "source:talent-registry": "node packages/source-host/scripts/generate-talent-registry.mjs",
    "dev:local": "npm run dev --workspace @genshin-dps-lab/web -- --host 127.0.0.1 --port 4179 --strictPort",
    "test:e2e:cloud": "node scripts/check-cloud-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "genshin-db": "5.2.12",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
