{
  "name": "genshin-dps-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "data:generate": "node packages/game-data/scripts/generate-catalog.mjs",
    "data:check": "node packages/game-data/scripts/generate-catalog.mjs --check",
    "dev": "npm run dev --workspace @genshin-dps-lab/web",
    "build": "npm run typecheck && npm run build --workspace @genshin-dps-lab/web",
    "preview": "npm run preview --workspace @genshin-dps-lab/web",
    "test": "npm run test:unit && npm run test:performance",
    "test:unit": "vitest run --exclude packages/sim-core/src/__tests__/performance.test.ts",
    "test:reactions": "vitest run packages/reaction-formulas/src/profile.test.ts packages/sim-core/src/__tests__/formulas.test.ts packages/sim-core/src/__tests__/amplifying.test.ts packages/sim-core/src/__tests__/reaction-matrix-golden.test.ts packages/sim-core/src/__tests__/burning.test.ts packages/sim-core/src/__tests__/burning-v151-e2e-gate.test.ts packages/sim-core/src/__tests__/overload.test.ts packages/sim-core/src/__tests__/superconduct.test.ts packages/sim-core/src/__tests__/electro-charged.test.ts packages/sim-core/src/__tests__/freeze.test.ts packages/sim-core/src/__tests__/shatter.test.ts packages/sim-core/src/__tests__/catalyze.test.ts packages/sim-core/src/__tests__/crystallize.test.ts packages/sim-core/src/__tests__/swirl.test.ts packages/sim-core/src/__tests__/bloom-aura.test.ts packages/sim-core/src/__tests__/bloom-gauge.test.ts packages/sim-core/src/__tests__/bloom-integration.test.ts packages/sim-core/src/__tests__/basic-reaction-scheduler.test.ts packages/sim-core/src/__tests__/basic-reaction-scheduler-result-schema.test.ts packages/sim-core/src/__tests__/basic-reaction-scheduler-result-integrity.test.ts packages/sim-core/src/__tests__/golden.test.ts packages/test-vectors/src/basic-reaction-scheduler-v151-golden.test.ts",
    "test:performance": "vitest run packages/sim-core/src/__tests__/performance.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run data:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.1",
    "genshin-db": "5.2.12",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
