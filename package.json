{
  "name": "genshin-dps-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "data:generate": "node packages/game-data/scripts/update-data.mjs normalize",
    "data:check": "node packages/game-data/scripts/update-data.mjs normalize --check",
    "dev": "npm run dev --workspace @genshin-dps-lab/web",
    "build": "npm run typecheck && npm run build --workspace @genshin-dps-lab/web",
    "preview": "npm run preview --workspace @genshin-dps-lab/web",
    "test": "npm run test:unit && npm run test:performance",
    "test:unit": "vitest run --exclude packages/sim-core/src/__tests__/performance.test.ts",
    "test:reactions": "vitest run packages/reaction-formulas/src/profile.test.ts packages/icd-profiles/src/application-profile.test.ts packages/icd-profiles/src/reaction-owned-application-policy.test.ts packages/icd-profiles/src/reaction-damage-group-policy.test.ts packages/icd-profiles/src/basic-reaction-scheduler-policy.test.ts packages/icd-profiles/src/freeze-broken-attack-policy.test.ts packages/icd-profiles/src/callback-bus-policy.test.ts packages/schemas/src/freeze-broken-attack-schema.test.ts packages/schemas/src/freeze-broken-attack-result-schema.test.ts packages/schemas/src/callback-bus-schema.test.ts packages/schemas/src/callback-bus-result-schema.test.ts packages/sim-core/src/elemental-application-icd.test.ts packages/sim-core/src/elemental-application-reaction-owned.test.ts packages/sim-core/src/freeze-broken-attack.test.ts packages/sim-core/src/callback-bus.test.ts packages/sim-core/src/callback-plugins.test.ts packages/sim-core/src/__tests__/formulas.test.ts packages/sim-core/src/__tests__/amplifying.test.ts packages/sim-core/src/__tests__/elemental-application-icd-integration-edges.test.ts packages/sim-core/src/__tests__/elemental-application-icd-result-integrity.test.ts packages/sim-core/src/__tests__/reaction-owned-application-integration.test.ts packages/sim-core/src/__tests__/reaction-owned-application-negative-matrix.test.ts packages/sim-core/src/__tests__/reaction-owned-application-result-integrity.test.ts packages/sim-core/src/__tests__/reaction-matrix-golden.test.ts packages/sim-core/src/__tests__/burning.test.ts packages/sim-core/src/__tests__/burning-v151-e2e-gate.test.ts packages/sim-core/src/__tests__/overload.test.ts packages/sim-core/src/__tests__/superconduct.test.ts packages/sim-core/src/__tests__/electro-charged.test.ts packages/sim-core/src/__tests__/electro-charged-propagation.test.ts packages/sim-core/src/__tests__/electro-charged-cleanup-schema.test.ts packages/sim-core/src/__tests__/electro-charged-global-cadence-golden.test.ts packages/sim-core/src/__tests__/freeze.test.ts packages/sim-core/src/__tests__/freeze-broken-attack-simulator.test.ts packages/sim-core/src/__tests__/freeze-broken-callback-bus-simulator.test.ts packages/sim-core/src/__tests__/shatter.test.ts packages/sim-core/src/__tests__/catalyze.test.ts packages/sim-core/src/__tests__/crystallize.test.ts packages/sim-core/src/__tests__/swirl.test.ts packages/sim-core/src/__tests__/bloom-aura.test.ts packages/sim-core/src/__tests__/bloom-gauge.test.ts packages/sim-core/src/__tests__/bloom-integration.test.ts packages/sim-core/src/__tests__/basic-reaction-scheduler.test.ts packages/sim-core/src/__tests__/basic-reaction-scheduler-result-schema.test.ts packages/sim-core/src/__tests__/basic-reaction-scheduler-result-integrity.test.ts packages/sim-core/src/__tests__/golden.test.ts packages/test-vectors/src/basic-reaction-scheduler-v151-golden.test.ts packages/test-vectors/src/project-v152-to-v151.test.ts packages/test-vectors/src/freeze-broken-attack-v152-golden.test.ts packages/test-vectors/src/project-v153-to-v152.test.ts packages/test-vectors/src/legacy-default-v153-golden.test.ts packages/reaction-formulas/src/special.test.ts packages/sim-core/src/special-calculator.test.ts",
