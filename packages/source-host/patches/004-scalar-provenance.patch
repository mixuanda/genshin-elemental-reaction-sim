@@ -0,0 +1,40 @@
+package info
+
+// Scalar receipts capture only the values and order of original getter calls.
+type SourceHostScalarRead struct {
+	ID string `json:"id"`
+	Kind string `json:"kind"`
+	Frame int `json:"frame"`
+	ActorIndex *int `json:"actorIndex,omitempty"`
+	TargetKey *int `json:"targetKey,omitempty"`
+	Element string `json:"element"`
+	Base float64 `json:"base"`
+	Steps []*SourceHostScalarStep `json:"steps"`
+	Sum float64 `json:"sum"`
+	Transforms []SourceHostScalarTransform `json:"transforms"`
+	Output float64 `json:"output"`
+}
+type SourceHostScalarStep struct {
+	Index int `json:"index"`
+	Key string `json:"key"`
+	ExpiryBefore int `json:"expiryBefore"`
+	ExpiryAfter int `json:"expiryAfter"`
+	AffectedByHitlag bool `json:"affectedByHitlag"`
+	Element string `json:"element"`
+	ClosureOpaque bool `json:"closureOpaque"`
+	Outcome string `json:"outcome"`
+	Before float64 `json:"before"`
+	Delta *float64 `json:"delta"`
+	After float64 `json:"after"`
+	Dependencies []*SourceHostStatRead `json:"dependencies"`
+}
+type SourceHostScalarTransform struct {
+	Kind string `json:"kind"`
+	Before float64 `json:"before"`
+	Limit float64 `json:"limit"`
+	After float64 `json:"after"`
+}
+type SourceHostScalarProvenance struct {
+	Version string `json:"version"`
+	Reads []*SourceHostScalarRead `json:"reads"`
+}
