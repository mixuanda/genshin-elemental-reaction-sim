+// Capture only real stat reads nested inside this particular ReactBonus Amount.
+func (c *CharWrapper) beginSourceHostScalarStep(step *info.SourceHostScalarStep) {
+	if step == nil { return }
+	c.sourceHostScalarSteps = append(c.sourceHostScalarSteps, step)
