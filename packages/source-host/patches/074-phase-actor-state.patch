+package player
+
+import (
+	"fmt"
+)
+
+// SourceHostPhaseState copies player-side runtime state without triggering
+// stamina-mod, shield-bonus, action readiness or character-stat calculations.
+func (h *Handler) SourceHostPhaseState() (map[string]any, []string) {
+	params := make(map[string]int, len(h.LastAction.Param))
+	for key, value := range h.LastAction.Param {
+		params[key] = value
+	}
+	positions := make(map[string]int, len(h.charPos))
+	for key, value := range h.charPos {
+		positions[key.String()] = value
+	}
+	characters := make([]map[string]any, 0, len(h.chars))
+	var gaps []string
+	for _, char := range h.chars {
+		state, charGaps := char.SourceHostPhaseState()
+		characters = append(characters, state)
+		gaps = append(gaps, charGaps...)
+	}
+	staminaMods := make([]map[string]any, 0, len(h.stamPercentMods))
+	for index, mod := range h.stamPercentMods {
+		remaining := mod.Expiry - *h.F
+		if mod.Expiry == -1 {
+			remaining = -1
+		}
+		staminaMods = append(staminaMods, map[string]any{
+			"key": mod.Key, "expiryRemaining": remaining,
+			"active": mod.Expiry == -1 || mod.Expiry > *h.F,
+		})
+		if mod.Amount != nil {
+			gaps = append(gaps, fmt.Sprintf("player.staminaModifier[%d].Amount callback", index))
+		}
+	}
+	animationState, animationGaps := h.AnimationHandler.SourceHostPhaseState()
+	shieldState, shieldGaps := h.Shields.SourceHostPhaseState()
+	infusionState, infusionGaps := h.Handler.SourceHostPhaseState()
+	gaps = append(gaps, animationGaps...)
+	gaps = append(gaps, shieldGaps...)
+	gaps = append(gaps, infusionGaps...)
+	state := map[string]any{
+		"activeCharacter": h.active, "characterPositions": positions,
+		"characters": characters,
+		"stamina":    h.Stam, "lastStaminaUseAgo": *h.F - h.LastStamUse,
+		"staminaModifiers": staminaMods,
+		"airborneSource":   int(h.airborne),
+		"swapCooldown":     h.SwapCD, "swapInterval": h.SwapICD,
+		"dashCooldownRemaining": h.DashCDExpirationFrame - *h.F,
+		"dashLockout":           h.DashLockout,
+		"lastAction": map[string]any{
+			"usedAgo": *h.F - h.LastAction.UsedAt, "type": h.LastAction.Type.String(),
+			"parameters": params, "characterIndex": h.LastAction.Char,
+		},
+		"verdantDew":                h.verdantDew,
+		"verdantDewExpiryRemaining": h.verdantDewExpiryFrame - *h.F,
+		"partialDewCount":           h.partialDewCount,
+		"moonridgeDew":              h.moonridgeDew,
+		"animation":                 animationState, "infusions": infusionState, "shields": shieldState,
+		"hitlagEnabled": h.EnableHitlag,
+	}
+	return state, gaps
+}
diff --git a/pkg/core/status/sourcehost_phase_state.go b/pkg/core/status/sourcehost_phase_state.go
