@@ -0,0 +1,43 @@
+package shield
+
+import "fmt"
+
+// SourceHostPhaseState copies live shield quantities and bonus-mod metadata.
+// ShieldStrength and ShieldBonus are intentionally not evaluated here.
+func (h *Handler) SourceHostPhaseState() (map[string]any, []string) {
+	shields := make([]map[string]any, 0, len(h.shields))
+	var gaps []string
+	for index, item := range h.shields {
+		state := map[string]any{
+			"owner": item.ShieldOwner(), "target": item.ShieldTarget(),
+			"key": item.Key(), "type": int(item.Type()), "description": item.Desc(),
+			"element": item.Element().String(), "hp": item.CurrentHP(),
+			"expiryRemaining": item.Expiry() - *h.f,
+			"implementation":  fmt.Sprintf("%T", item),
+		}
+		if tmpl, ok := item.(*Tmpl); ok {
+			state["sourceHostHPSource"] = tmpl.SourceHostHPID
+			state["sourceHostBonusSource"] = tmpl.SourceHostBonusID
+			if tmpl.SourceHostDamage != nil {
+				gaps = append(gaps, fmt.Sprintf("shield[%d].SourceHostDamage callback", index))
+			}
+		} else {
+			gaps = append(gaps, fmt.Sprintf("shield[%d] custom implementation private state", index))
+		}
+		shields = append(shields, state)
+	}
+	bonusMods := make([]map[string]any, 0, len(h.shieldBonusMods))
+	for index, mod := range h.shieldBonusMods {
+		expiry := mod.Expiry - *h.f
+		if mod.Expiry == -1 {
+			expiry = -1
+		}
+		bonusMods = append(bonusMods, map[string]any{
+			"key": mod.Key, "expiryRemaining": expiry, "active": mod.Expiry == -1 || mod.Expiry > *h.f,
+		})
+		if mod.Amount != nil {
+			gaps = append(gaps, fmt.Sprintf("shield bonus modifier[%d].Amount callback", index))
+		}
+	}
+	return map[string]any{"shields": shields, "bonusModifiers": bonusMods}, gaps
+}
