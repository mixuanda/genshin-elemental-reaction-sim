@@ -0,0 +1,35 @@
+package action
+
+// SourceHostPhaseState copies animation progress without advancing queued work
+// or invoking character-specific animation rules.
+func (a *Info) SourceHostPhaseState() (map[string]any, []string) {
+	queued := make([]map[string]any, 0, len(a.queued))
+	for _, item := range a.queued {
+		queued = append(queued, map[string]any{"remainingTime": item.delay - a.TimePassed})
+	}
+	state := map[string]any{
+		"animationLength":      a.AnimationLength,
+		"canQueueAfter":        a.CanQueueAfter,
+		"state":                a.State.String(),
+		"timePassed":           a.TimePassed,
+		"normalizedTimePassed": a.NormalizedTimePassed,
+		"queuedActions":        queued,
+	}
+	var gaps []string
+	if a.Frames != nil {
+		gaps = append(gaps, "animation.Frames callback")
+	}
+	if a.FramePausedOnHitlag != nil {
+		gaps = append(gaps, "animation.FramePausedOnHitlag callback")
+	}
+	if a.OnRemoved != nil {
+		gaps = append(gaps, "animation.OnRemoved callback")
+	}
+	if a.UseNormalizedTime != nil {
+		gaps = append(gaps, "animation.UseNormalizedTime callback")
+	}
+	if len(a.queued) > 0 {
+		gaps = append(gaps, "animation queued action callbacks")
+	}
+	return state, gaps
+}
