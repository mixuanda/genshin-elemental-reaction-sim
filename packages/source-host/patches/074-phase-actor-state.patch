+++ b/pkg/core/player/animation/sourcehost_phase_state.go
@@ -0,0 +1,21 @@
+package animation
+
+// SourceHostPhaseState reads stored animation fields; it does not call the
+// action's CanUse, CanQueueNext or Tick methods.
+func (h *AnimationHandler) SourceHostPhaseState() (map[string]any, []string) {
+	frame := *h.f
+	state := map[string]any{
+		"characterIndex":       h.char,
+		"startedAgo":           frame - h.started,
+		"lastAction":           h.lastAct.String(),
+		"state":                h.state.String(),
+		"stateExpiryRemaining": h.stateExpiry - frame,
+		"active":               h.aniEvt != nil,
+	}
+	if h.aniEvt == nil {
+		return state, nil
+	}
+	info, gaps := h.aniEvt.SourceHostPhaseState()
+	state["actionInfo"] = info
+	return state, gaps
+}
diff --git a/pkg/core/player/character/sourcehost_phase_state.go b/pkg/core/player/character/sourcehost_phase_state.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/player/character/sourcehost_phase_state.go
@@ -0,0 +1,137 @@
+package character
+
+import (
+	"fmt"
+	"sort"
+)
+
+// SourceHostPhaseState copies the common character wrapper. In particular it
+// does not call Stats, Cooldown, Charges, Snapshot, or mod Amount closures.
+func (c *CharWrapper) SourceHostPhaseState() (map[string]any, []string) {
+	tags := make(map[string]int, len(c.Tags))
+	for key, value := range c.Tags {
+		tags[key] = value
+	}
+	baseStats := make([]float64, len(c.BaseStats))
+	copy(baseStats, c.BaseStats[:])
+	setKeys := make([]string, 0, len(c.Equip.Sets))
+	setCounts := make(map[string]int, len(c.Equip.Sets))
+	for key, set := range c.Equip.Sets {
+		name := key.String()
+		setKeys = append(setKeys, name)
+		setCounts[name] = set.GetCount()
+	}
+	sort.Strings(setKeys)
+	sets := make([]map[string]any, 0, len(setKeys))
+	for _, key := range setKeys {
+		sets = append(sets, map[string]any{"key": key, "count": setCounts[key]})
+	}
+	mods := make([]map[string]any, 0, len(c.mods))
+	var gaps []string
+	for index, mod := range c.mods {
+		kind := fmt.Sprintf("%T", mod)
+		expiry := mod.Expiry()
+		remaining := expiry - *c.f
+		if expiry == -1 {
+			remaining = -1
+		}
+		entry := map[string]any{
+			"key": mod.Key(), "kind": kind, "expiryRemaining": remaining,
+			"active":           expiry == -1 || expiry > *c.f,
+			"affectedByHitlag": mod.AffectedByHitlag(),
+		}
+		switch typed := mod.(type) {
+		case *Status:
+			entry["duration"] = typed.Dur
+		case *StatMod:
+			entry["duration"] = typed.Dur
+			entry["affectedStat"] = typed.AffectedStat.String()
+			entry["extra"] = typed.Extra
+			if typed.Amount != nil {
+				gaps = append(gaps, fmt.Sprintf("character[%d].modifier[%d].Amount callback", c.index, index))
+			}
+		case *AttackMod:
+			entry["duration"] = typed.Dur
+			if typed.Amount != nil {
+				gaps = append(gaps, fmt.Sprintf("character[%d].modifier[%d].Amount callback", c.index, index))
+			}
+		case *CooldownMod:
+			entry["duration"] = typed.Dur
+			if typed.Amount != nil {
+				gaps = append(gaps, fmt.Sprintf("character[%d].modifier[%d].Amount callback", c.index, index))
+			}
+		case *DamageReductionMod:
+			entry["duration"] = typed.Dur
+			if typed.Amount != nil {
+				gaps = append(gaps, fmt.Sprintf("character[%d].modifier[%d].Amount callback", c.index, index))
+			}
+		case *HealBonusMod:
+			entry["duration"] = typed.Dur
+			if typed.Amount != nil {
+				gaps = append(gaps, fmt.Sprintf("character[%d].modifier[%d].Amount callback", c.index, index))
+			}
+		case *ReactBonusMod:
+			entry["duration"] = typed.Dur
+			if typed.Amount != nil {
+				gaps = append(gaps, fmt.Sprintf("character[%d].modifier[%d].Amount callback", c.index, index))
+			}
+		default:
+			gaps = append(gaps, fmt.Sprintf("character[%d].modifier[%d] private implementation", c.index, index))
+		}
+		mods = append(mods, entry)
+	}
+	state := map[string]any{
+		"index":          c.index,
+		"implementation": fmt.Sprintf("%T", c.Character),
+		"base": map[string]any{
+			"key": c.Base.Key.String(), "element": c.Base.Element.String(),
+			"level": c.Base.Level, "maxLevel": c.Base.MaxLevel,
+			"ascension": c.Base.Ascension, "constellation": c.Base.Cons,
+			"rarity": c.Base.Rarity,
+		},
+		"weapon": map[string]any{
+			"key": c.Weapon.Key.String(), "level": c.Weapon.Level,
+			"maxLevel": c.Weapon.MaxLevel, "refinement": c.Weapon.Refine,
+			"class": c.Weapon.Class.String(),
+		},
+		"talents":       c.Talents,
+		"artifactSets":  sets,
+		"characterZone": int(c.CharZone), "characterBody": int(c.CharBody),
+		"normalConstellation": c.NormalCon, "skillConstellation": c.SkillCon,
+		"burstConstellation": c.BurstCon, "hasArkhe": c.HasArkhe,
+		"isHexerei": c.IsHexerei, "moonsign": c.Moonsign,
+		"particleDelay": c.ParticleDelay,
+		"energy":        c.Energy, "energyMax": c.EnergyMax,
+		"hpRatio": c.CurrentHPRatio(), "hpDebt": c.CurrentHPDebt(),
+		"startHP": c.StartHP, "startHPRatio": c.StartHPRatio,
+		"normalHitNum": c.NormalHitNum, "normalCounter": c.NormalCounter,
+		"tags": tags, "baseStats": baseStats, "modifiers": mods,
+		"remainingDashCD": c.RemainingDashCD, "dashLockout": c.DashLockout,
+		"timePassed": c.TimePassed, "localClockLag": *c.f - c.TimePassed,
+		"frozenFrames": c.frozenFrames,
+	}
+	if concrete, ok := c.Character.(interface {
+		SourceHostTemplatePhaseState() (map[string]any, []string)
+	}); ok {
+		concreteState, concreteGaps := concrete.SourceHostTemplatePhaseState()
+		state["sharedImplementation"] = concreteState
+		gaps = append(gaps, concreteGaps...)
+	} else {
+		gaps = append(gaps, fmt.Sprintf("character[%d] shared cooldown implementation unavailable", c.index))
+	}
+	if c.queue != nil {
+		localTasks, taskGaps := c.queue.SourceHostPhaseState()
+		state["localTasks"] = localTasks
+		gaps = append(gaps, taskGaps...)
+	}
+	// Concrete character, weapon and artifact implementations hold mutable
+	// private state unavailable through their shared interfaces.
+	gaps = append(gaps, fmt.Sprintf("character[%d] concrete implementation private state", c.index))
+	if c.Equip.Weapon != nil {
+		gaps = append(gaps, fmt.Sprintf("character[%d] weapon implementation private state", c.index))
+	}
+	if len(c.Equip.Sets) > 0 {
+		gaps = append(gaps, fmt.Sprintf("character[%d] artifact set implementation private state", c.index))
+	}
+	return state, gaps
+}
diff --git a/pkg/core/player/infusion/sourcehost_phase_state.go b/pkg/core/player/infusion/sourcehost_phase_state.go
