+package infusion
+
+// SourceHostPhaseState copies each character's stored infusion without calling
+// Infused, which answers for one attack tag rather than describing the state.
+func (h *Handler) SourceHostPhaseState() (map[string]any, []string) {
+	entries := make([]map[string]any, len(h.infusion))
+	for index, inf := range h.infusion {
+		tags := make([]int, len(inf.Tags))
+		for i, tag := range inf.Tags {
+			tags[i] = int(tag)
+		}
+		expiryRemaining := inf.Expiry - float64(*h.f)
+		if inf.Expiry == -1 {
+			expiryRemaining = -1
+		}
+		entries[index] = map[string]any{
+			"characterIndex": index, "key": inf.Key, "element": inf.Ele.String(),
+			"attackTags": tags, "expiryRemaining": expiryRemaining,
+			"canBeOverridden": inf.CanBeOverridden,
+		}
+	}
+	return map[string]any{"entries": entries}, nil
+}
