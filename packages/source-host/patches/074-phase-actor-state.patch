+package character
+
+import (
+	"fmt"
+
+	"github.com/genshinsim/gcsim/pkg/core/action"
+)
+
+// SourceHostTemplatePhaseState reads the shared character implementation's cooldown
+// queues and HP fields without calling Cooldown or any modifier computation.
+func (c *Character) SourceHostTemplatePhaseState() (map[string]any, []string) {
+	cooldowns := make([]map[string]any, 0, len(c.ActionCD))
+	var gaps []string
+	for index := range c.ActionCD {
+		queue := append([]int(nil), c.cdQueue[index]...)
+		workerPresent := c.cdCurrentQueueWorker[index] != nil
+		remaining := 0
+		if len(queue) > 0 {
+			remaining = c.cdQueueWorkerStartedAt[index] + queue[0] - c.Core.F
+		}
+		cooldowns = append(cooldowns, map[string]any{
+			"action":                   action.Action(index).String(),
+			"actionCD":                 c.ActionCD[index],
+			"availableCharges":         c.AvailableCDCharge[index],
+			"additionalCharges":        c.additionalCDCharge[index],
+			"queueDurations":           queue,
+			"workerStartedAgo":         c.Core.F - c.cdQueueWorkerStartedAt[index],
+			"currentCooldownRemaining": remaining,
+			"workerPresent":            workerPresent,
+		})
+		if workerPresent {
+			gaps = append(gaps, fmt.Sprintf("character[%d].cooldown[%d] worker callback", c.Index(), index))
+		}
+	}
+	return map[string]any{
+		"cooldowns":     cooldowns,
+		"storedHPRatio": c.currentHPRatio,
+		"storedHPDebt":  c.currentHPDebt,
+	}, gaps
+}
