+++ b/pkg/core/status/sourcehost_phase_state.go
@@ -0,0 +1,22 @@
+package status
+
+import "sort"
+
+// SourceHostPhaseState includes retained expired entries because their presence
+// can affect a later refresh, even when Duration would currently return zero.
+func (h *Handler) SourceHostPhaseState() (map[string]any, []string) {
+	keys := make([]string, 0, len(h.status))
+	for key := range h.status {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	entries := make([]map[string]any, 0, len(keys))
+	for _, key := range keys {
+		entry := h.status[key]
+		entries = append(entries, map[string]any{
+			"key": key, "expiryRemaining": entry.expiry - *h.f,
+			"active": entry.expiry > *h.f,
+		})
+	}
+	return map[string]any{"entries": entries}, nil
+}
