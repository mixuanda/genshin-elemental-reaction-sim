+// EmitObserved preserves audited measurement hooks while suppressing gameplay
+// hooks for a target whose hit confirmation is blocked.
+type ObservedEmission struct {
+	GameplaySkipped int
+	ObserversEmitted int
+}
+
+func (h *Handler) EmitObserved(e Event, args ...any) ObservedEmission {
+	var result ObservedEmission
+	for _, v := range h.events[e] {
+		if v.f == nil { continue }
+		if !v.phase.Observational || v.phase.Source == "" {
+			result.GameplaySkipped++
+			continue
+		}
+		if h.Origin == nil {
+			v.f(args...)
+		} else {
+			end := h.Origin.BeginEvent(v.origin, v.key, int(e), args...)
+			v.f(args...)
+			end()
+		}
+		result.ObserversEmitted++
+	}
+	return result
+}
