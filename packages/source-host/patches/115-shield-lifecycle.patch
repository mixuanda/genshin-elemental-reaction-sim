+// Observe the exact callback without changing native hook/event ordering.
+func (h *Handler) sourceHostBeginHook(shd Shield, cause string) func() {
+	if h.SourceHostLifecycle == nil {
+		return nil
+	}
+	return h.SourceHostLifecycle.BeginShieldHook(shd, "", cause)
