+++ b/internal/characters/varka/multiplier.go
@@ -0,0 +1,28 @@
+package varka
+
+// sourceSkillMultiplier evaluates the source's complete Mult field at its
+// original struct-literal position. The A1 and C1 values have their own
+// creation receipts, reused by every hit of this action.
+func (c *char) sourceSkillMultiplier(base, a1, c1 float64, c1ID int, withC1 bool, activeRule, unascRule string) (float64, int) {
+	if c.Core.SourceHost == nil {
+		if withC1 {
+			return base * a1 * c1, 0
+		}
+		return base * a1, 0
+	}
+	state := map[string]any{"baseTalent": base}
+	valueSources := map[string]int{}
+	rule := unascRule
+	if c.a1MultiplierSourceID > 0 {
+		rule = activeRule
+		state["a1Factor"] = a1
+		valueSources["a1Factor"] = c.a1MultiplierSourceID
+	} else {
+		state["ascension"] = c.Base.Ascension
+	}
+	if withC1 {
+		state["c1Factor"] = c1
+		valueSources["c1Factor"] = c1ID
+	}
+	return c.Core.SourceHost.CharacterMultiplierCompute(c.Index(), rule, 0, state, nil, 0, valueSources)
+}
