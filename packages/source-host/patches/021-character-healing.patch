+func (c *Character) calcHealAmountWithReceipts(hi *info.HealInfo) (float64, float64, int, int) {
+	var hp, bonus float64
+	var maxHPRead *info.SourceHostStatRead
+	healType := "unsupported"
+	baseInput := map[string]any{"operation": "base", "sourceAmount": hi.Src}
+	switch hi.Type {
+	case info.HealTypeAbsolute:
+		healType = "absolute"
+		hp = hi.Src
+	case info.HealTypePercent:
+		healType = "percent"
+		maxHP := 0.0
+		if c.Core.SourceHost != nil {
+			maxHP, maxHPRead = c.MaxHPWithProvenance()
+		} else {
+			maxHP = c.MaxHP()
+		}
+		baseInput["maxHpForBase"] = maxHP
+		hp = maxHP * hi.Src
+	default:
+		baseInput["originalHealType"] = int(hi.Type)
+	}
+	baseInput["healType"] = healType
+	baseID, bonusID := 0, 0
+	if c.Core.SourceHost != nil {
+		hp, baseID = c.Core.SourceHost.CharacterHealing(c.Index(), hi.Message, baseInput, maxHPRead, nil, nil)
+	}
+	healBonus := 0.0
+	var bonusRead *info.SourceHostScalarRead
+	if c.Core.SourceHost != nil {
+		healBonus, bonusRead = c.HealBonusWithProvenance()
+	} else {
+		healBonus = c.HealBonus()
+	}
+	bonus = 1 + healBonus + hi.Bonus
+	if c.Core.SourceHost != nil {
+		bonus, bonusID = c.Core.SourceHost.CharacterHealing(c.Index(), hi.Message,
+			map[string]any{"operation": "bonus", "healBonus": healBonus, "infoBonus": hi.Bonus}, nil, bonusRead, nil)
+	}
+	return hp, bonus, baseID, bonusID
+}
