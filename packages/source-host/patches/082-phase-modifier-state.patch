--- /dev/null
+++ b/pkg/modifier/sourcehost_phase_callback.go
@@ -0,0 +1,23 @@
+package modifier
+
+import "github.com/genshinsim/gcsim/pkg/core/phase"
+
+// WithPhase attaches source-audited, read-only closure metadata. It does not
+// change the modifier's value, expiry or execution. The observer must return
+// copied live captures and semantic references to other captured providers.
+func WithPhase(base Base, source string, observe func() (map[string]any, []string)) Base {
+	base.Phase = &phase.Descriptor{Source: source, Observe: observe}
+	return base
+}
+
+func (b *Base) SourceHostPhaseCallback() (map[string]any, []string) {
+	if b.Phase == nil || b.Phase.Source == "" || b.Phase.Observe == nil {
+		return nil, []string{"Amount callback has no source-reviewed live capture descriptor"}
+	}
+	// Amount affects gameplay even when a caller mistakenly labels it observational.
+	state, gaps := b.Phase.Observe()
+	if state == nil {
+		state = map[string]any{}
+	}
+	return map[string]any{"source": b.Phase.Source, "capture": state}, gaps
+}
