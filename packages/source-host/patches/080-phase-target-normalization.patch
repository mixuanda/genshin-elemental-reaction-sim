diff --git a/pkg/core/combat/sourcehost_phase.go b/pkg/core/combat/sourcehost_phase.go
--- a/pkg/core/combat/sourcehost_phase.go
+++ b/pkg/core/combat/sourcehost_phase.go
@@ -48,9 +48,16 @@
