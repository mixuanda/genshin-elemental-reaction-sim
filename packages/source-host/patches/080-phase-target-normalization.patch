-	gadgets := make([]map[string]any, len(h.gadgets))
-	for i, target := range h.gadgets {
-		gadgets[i] = capture(target, fmt.Sprintf("gadgets[%d]", i))
+	// The source collector only removes nil slots, retaining the order of all
+	// remaining gadgets. Production consumers iterate/filter that same order;
+	// no source gameplay call addresses a gadget by its backing-slice index.
+	// Normalize storage holes and omit the collector's 101-frame cadence.
+	gadgets := make([]map[string]any, 0, len(h.gadgets))
+	for _, target := range h.gadgets {
+		if target == nil {
+			continue
+		}
+		gadgets = append(gadgets, capture(target, fmt.Sprintf("gadgets[%d]", len(gadgets))))
 	}
-	return map[string]any{"enemies": enemies, "gadgets": gadgets, "player": capture(h.player, "player"), "defaultTarget": h.DefaultTarget, "nextTargetKey": h.keycount, "gadgetCollectionTick": h.gccount, "damageMode": h.DamageMode, "defenseHalt": h.DefHalt, "hitlagEnabled": h.EnableHitlag}, gaps
+	return map[string]any{"enemies": enemies, "gadgets": gadgets, "player": capture(h.player, "player"), "defaultTarget": h.DefaultTarget, "nextTargetKey": h.keycount, "damageMode": h.DamageMode, "defenseHalt": h.DefHalt, "hitlagEnabled": h.EnableHitlag}, gaps
 }
