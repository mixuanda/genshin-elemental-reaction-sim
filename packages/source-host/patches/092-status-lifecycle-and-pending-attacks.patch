+// sourceHostStatusForKey identifies the exact object modifier.Add will replace.
+func (c *CharWrapper) sourceHostStatusForKey(key string) *Status {
+	i := modifier.Find(&c.mods, key)
+	if i < 0 {
+		return nil
+	}
+	status, _ := c.mods[i].(*Status)
+	return status
+}
+
+func (c *CharWrapper) sourceHostRecordReplacement(previous *Status) {
+	if c.SourceHost != nil && previous != nil {
+		c.SourceHost.RecordStatusReplaced(previous.SourceHostStatusOwner, previous.Expiry())
+	}
+}
+
+// SourceHostObserveStatusesAtEnd reads only actual retained Status objects.
+func (c *CharWrapper) SourceHostObserveStatusesAtEnd() {
+	if c.SourceHost == nil {
+		return
+	}
+	for _, mod := range c.mods {
+		if status, ok := mod.(*Status); ok {
+			c.SourceHost.ObserveLiveStatus(status.SourceHostStatusOwner, status.Expiry())
+		}
+	}
+}
