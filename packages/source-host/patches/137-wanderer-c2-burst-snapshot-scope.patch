+// Snapshot scopes the stored C2 vector to this attack's snapshot, not the
+// current animation. Pending C6 hits and Nicole projections can snapshot while
+// the burst animation is running. Keep the original delayed snapshot and C2
+// lifetime, and restore the outer context for nested reads and panics.
+func (c *char) Snapshot(a *info.AttackInfo) info.Snapshot {
+	previous := c.c2SnapshotBurst
+	c.c2SnapshotBurst = a.AttackTag == attacks.AttackTagElementalBurst
+	defer func() { c.c2SnapshotBurst = previous }()
+	return c.Character.Snapshot(a)
 }
 
