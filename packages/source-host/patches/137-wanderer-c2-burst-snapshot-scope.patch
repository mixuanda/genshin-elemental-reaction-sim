+package wanderer
+
+import (
+	"testing"
+
+	"github.com/genshinsim/gcsim/pkg/core"
+	"github.com/genshinsim/gcsim/pkg/core/attacks"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+	"github.com/genshinsim/gcsim/pkg/core/keys"
+	"github.com/genshinsim/gcsim/pkg/core/player/character"
+)
+
+func newC2SnapshotChar(t *testing.T, cons int) *char {
+	t.Helper()
+	s, err := core.New(core.Opt{Seed: 1})
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := info.CharacterProfile{
+		Base:    info.CharacterBase{Key: keys.Wanderer, Cons: cons, Level: 100},
+		Talents: info.TalentProfile{Attack: 10, Skill: 10, Burst: 10},
+		Stats:   make([]float64, attributes.EndStatType),
+	}
+	w, err := character.New(p, &s.F, false, s.Log, s.Events, s.Tasks)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = NewChar(s, w, p); err != nil {
+		t.Fatal(err)
+	}
+	return w.Character.(*char)
+}
+
+func c2SnapshotAttack(tag attacks.AttackTag, name string) info.AttackInfo {
+	return info.AttackInfo{AttackTag: tag, Abil: name, IgnoreInfusion: true}
+}
+
+// This regression compiles against both pre-137 and post-137 source. It must
+// fail numerically (2 != 0) before the fix, not fail to compile on a new field.
+func TestWandererC2RejectsNonQ(t *testing.T) {
+	for _, ai := range []info.AttackInfo{
+		c2SnapshotAttack(attacks.AttackTagNormal, "Shugen: The Curtains’ Melancholic Sway"),
+		c2SnapshotAttack(attacks.AttackTagNone, "Arcane Projection: Unity"),
+	} {
+		t.Run(ai.Abil, func(t *testing.T) {
+			c := newC2SnapshotChar(t, 6)
+			c.maxSkydwellerPoints, c.skydwellerPoints = 120, 31
+			c.c2()
+			c.Core.F = 8
+			got := c.CharWrapper.Character.Snapshot(&ai).Stats[attributes.DmgP]
+			if got != 0 {
+				t.Fatalf("Q-only C2 leaked into non-Q snapshot: got %v, want 0", got)
+			}
+		})
+	}
+}
