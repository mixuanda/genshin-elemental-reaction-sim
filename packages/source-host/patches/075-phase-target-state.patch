+package avatar
+
+func (p *Player) SourceHostPhaseState() (map[string]any, []string) {
+	target, gaps := p.Target.SourceHostPhaseState()
+	state := map[string]any{"target": target}
+	if provider, ok := p.Reactable.(interface {
+		SourceHostPhaseState() (map[string]any, []string)
+	}); ok {
+		value, missing := provider.SourceHostPhaseState()
+		state["reaction"] = value
+		for _, gap := range missing {
+			gaps = append(gaps, "avatar.reaction."+gap)
+		}
+	} else {
+		gaps = append(gaps, "avatar.reaction-private-state")
+	}
+	return state, gaps
+}
