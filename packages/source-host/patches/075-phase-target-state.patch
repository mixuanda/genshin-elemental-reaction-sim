diff --git a/pkg/enemy/sourcehost_phase.go b/pkg/enemy/sourcehost_phase.go
new file mode 100644
--- /dev/null
+++ b/pkg/enemy/sourcehost_phase.go
@@ -0,0 +1,73 @@
+package enemy
+
+import (
+	"fmt"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+
+type sourceHostPhaseProvider interface {
+	SourceHostPhaseState() (map[string]any, []string)
+}
+
+func (e *Enemy) SourceHostPhaseState() (map[string]any, []string) {
+	target, gaps := e.Target.SourceHostPhaseState()
+	resists := map[string]float64{}
+	for element, value := range e.resists {
+		resists[element.String()] = value
+	}
+	mods := []map[string]any{}
+	for _, mod := range e.mods {
+		row := map[string]any{"key": mod.Key(), "type": fmt.Sprintf("%T", mod), "hitlag": mod.AffectedByHitlag()}
+		if metadata, ok := mod.(interface{ SourceHostPhaseMetadata(int) map[string]any }); ok {
+			row["lifetime"] = metadata.SourceHostPhaseMetadata(e.Core.F)
+		} else {
+			gaps = append(gaps, "enemy.modifier-lifetime-private-state:"+mod.Key())
+		}
+		switch m := mod.(type) {
+		case *info.Status:
+		case *info.ResistMod:
+			row["element"] = m.Ele.String()
+			row["value"] = m.Value
+		case *info.DefMod:
+			row["value"] = m.Value
+			row["duration"] = m.Dur
+		default:
+			gaps = append(gaps, "enemy.modifier-private-state:"+mod.Key())
+		}
+		mods = append(mods, row)
+	}
+	state := map[string]any{"target": target, "level": e.Level, "resists": resists, "hp": e.hp, "maxHp": e.maxhp, "frozenFrames": e.frozenFrames, "modifiers": mods, "particleDropIndex": e.particleDropIndex}
+	drops := []map[string]any{}
+	for _, drop := range e.prof.ParticleDrops {
+		if drop == nil {
+			drops = append(drops, nil)
+		} else {
+			drops = append(drops, map[string]any{"dropId": drop.DropId, "hpPercent": drop.HpPercent})
+		}
+	}
+	state["particleProfile"] = map[string]any{"threshold": e.prof.ParticleDropThreshold, "count": e.prof.ParticleDropCount, "element": e.prof.ParticleElement.String(), "hpDrops": drops}
+	if e.prof.ParticleDropThreshold > 0 {
+		state["damageSinceParticleThreshold"] = e.damageTaken - float64(e.lastParticleDrop)*e.prof.ParticleDropThreshold
+	}
+	if provider, ok := e.Reactable.(sourceHostPhaseProvider); ok {
+		value, missing := provider.SourceHostPhaseState()
+		state["reaction"] = value
+		for _, gap := range missing {
+			gaps = append(gaps, "enemy.reaction."+gap)
+		}
+	} else {
+		gaps = append(gaps, "enemy.reaction-private-state")
+	}
+	if provider, ok := any(e.queue).(sourceHostPhaseProvider); ok {
+		value, missing := provider.SourceHostPhaseState()
+		state["taskQueue"] = value
+		for _, gap := range missing {
+			gaps = append(gaps, "enemy.taskQueue."+gap)
+		}
+	} else {
+		gaps = append(gaps, "enemy.taskQueue-private-state")
+	}
+	// timePassed is a local clock. Task deadlines are normalized by that same
+	// clock in the queue provider; absolute time is not a phase state variable.
+	return state, gaps
+}
