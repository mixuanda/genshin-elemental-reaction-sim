@@ -0,0 +1,31 @@
+package construct
+
+import "fmt"
+
+func (h *Handler) SourceHostPhaseState() (map[string]any, []string) {
+	gaps := []string{}
+	capture := func(list []Construct, path string) []map[string]any {
+		rows := make([]map[string]any, len(list))
+		for i, c := range list {
+			if c == nil {
+				continue
+			}
+			expiry := c.Expiry()
+			row := map[string]any{"concreteType": fmt.Sprintf("%T", c), "key": c.Key(), "type": c.Type(), "expiryOffsetFrames": expiry - *h.f, "limited": c.IsLimited(), "count": c.Count(), "direction": c.Direction(), "position": c.Pos()}
+			if provider, ok := c.(interface {
+				SourceHostPhaseConstructState() (map[string]any, []string)
+			}); ok {
+				value, missing := provider.SourceHostPhaseConstructState()
+				row["privateState"] = value
+				for _, gap := range missing {
+					gaps = append(gaps, fmt.Sprintf("%s[%d].%s", path, i, gap))
+				}
+			} else {
+				gaps = append(gaps, fmt.Sprintf("%s[%d].construct-private-state-and-on-destruct:%T", path, i, c))
+			}
+			rows[i] = row
+		}
+		return rows
+	}
+	return map[string]any{"limited": capture(h.constructs, "limited"), "unlimited": capture(h.consNoLimit, "unlimited")}, gaps
+}
