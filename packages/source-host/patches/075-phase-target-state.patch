+package modifier
+
+// SourceHostPhaseMetadata reads the duration/extension state without calling
+// modifier effects or touching the event used only for logging.
+func (b *Base) SourceHostPhaseMetadata(frame int) map[string]any {
+	expiry := b.Expiry()
+	return map[string]any{"key": b.ModKey, "duration": b.Dur, "infinite": expiry == -1, "expired": expiry != -1 && expiry < frame, "remainingFrames": max(0, expiry-frame), "hitlag": b.Hitlag, "extension": b.extension}
+}
diff --git a/pkg/reactable/sourcehost_phase.go b/pkg/reactable/sourcehost_phase.go
new file mode 100644
--- /dev/null
+++ b/pkg/reactable/sourcehost_phase.go
@@ -0,0 +1,45 @@
+package reactable
+
+import "github.com/genshinsim/gcsim/pkg/core/info"
+
+func sourceHostPhaseReactionSnapshot(snapshot info.Snapshot) map[string]any {
+	// Snapshot log/provenance IDs do not influence the future damage calculation.
+	return map[string]any{"stats": snapshot.Stats, "characterLevel": snapshot.CharLvl}
+}
+
+func sourceHostPhaseReactionAttack(attack info.AttackInfo) info.AttackInfo {
+	attack.AdditionalTags = append(attack.AdditionalTags[:0:0], attack.AdditionalTags...)
+	attack.SourceHostComponents = nil
+	attack.SourceHostMultiplierID = 0
+	return attack
+}
+
+func (r *Reactable) SourceHostPhaseState() (map[string]any, []string) {
+	state := map[string]any{"durabilityByOwner": r.Durability, "decayRates": r.DecayRate, "freezeResist": r.FreezeResist, "lunarChargedOwner": r.lcAtkOwner}
+	state["gcdRemainingFrames"] = map[string]int{"overload": max(0, r.overloadGCD-r.core.F), "shatter": max(0, r.shatterGCD-r.core.F), "superconduct": max(0, r.superconductGCD-r.core.F), "swirlElectro": max(0, r.swirlElectroGCD-r.core.F), "swirlHydro": max(0, r.swirlHydroGCD-r.core.F), "swirlCryo": max(0, r.swirlCryoGCD-r.core.F), "swirlPyro": max(0, r.swirlPyroGCD-r.core.F), "crystallize": max(0, r.crystallizeGCD-r.core.F)}
+	gaps := []string{}
+	ec := map[string]any{"active": r.ecTickSrc != -1}
+	if r.ecTickSrc != -1 {
+		ec["generationAgeFrames"] = r.core.F - r.ecTickSrc
+		ec["attack"] = sourceHostPhaseReactionAttack(r.ecAtk)
+		ec["snapshot"] = sourceHostPhaseReactionSnapshot(r.ecSnapshot)
+		gaps = append(gaps, "electrocharged-task-and-event-captured-state")
+	}
+	state["electrocharged"] = ec
+	burning := map[string]any{"active": r.burningTickSrc != -1}
+	if r.burningTickSrc != -1 {
+		burning["generationAgeFrames"] = r.core.F - r.burningTickSrc
+		burning["attack"] = sourceHostPhaseReactionAttack(r.burningAtk)
+		burning["snapshot"] = sourceHostPhaseReactionSnapshot(r.burningSnapshot)
+		gaps = append(gaps, "burning-task-captured-counter-and-generation")
+	}
+	state["burning"] = burning
+	return state, gaps
+}
+
+// This construct has only the fields already read by construct.Handler and an
+// empty OnDestruct method. Unlike callback-backed constructs it has no extra
+// private continuation state.
+func (c *LunarCrystallizeConstruct) SourceHostPhaseConstructState() (map[string]any, []string) {
+	return map[string]any{}, nil
+}
diff --git a/pkg/target/sourcehost_phase.go b/pkg/target/sourcehost_phase.go
new file mode 100644
--- /dev/null
+++ b/pkg/target/sourcehost_phase.go
@@ -0,0 +1,31 @@
+package target
+
+// SourceHostPhaseState is a read-only export. ICD reset tasks live in the core
+// queue and their captured values must also be covered before claiming closure.
+func (t *Target) SourceHostPhaseState() (map[string]any, []string) {
+	tags := make(map[string]int, len(t.Tags))
+	for key, value := range t.Tags {
+		tags[key] = value
+	}
+	shape, _ := t.Hitbox.SourceHostPhaseState()
+	gaps := []string{}
+	if t.OnCollision != nil {
+		gaps = append(gaps, "target.collision-callback-captured-state")
+	}
+	if len(tags) > 0 {
+		gaps = append(gaps, "target.tag-value-temporal-semantics")
+	}
+	icd := []map[string]any{}
+	for actor := range t.icdTagOnTimer {
+		for tag := range t.icdTagOnTimer[actor] {
+			on := t.icdTagOnTimer[actor][tag]
+			count := t.icdTagCounter[actor][tag]
+			damageOn := t.icdDamageTagOnTimer[actor][tag]
+			damageCount := t.icdDamageTagCounter[actor][tag]
+			if on || count != 0 || damageOn || damageCount != 0 {
+				icd = append(icd, map[string]any{"actor": actor, "tag": tag, "applicationOnTimer": on, "applicationCounter": count, "damageOnTimer": damageOn, "damageCounter": damageCount})
+			}
+		}
+	}
+	return map[string]any{"key": t.key, "alive": t.Alive, "shape": shape, "direction": t.direction, "tags": tags, "collidableTypes": t.CollidableTypes, "hasCollisionCallback": t.OnCollision != nil, "icd": icd}, gaps
+}
