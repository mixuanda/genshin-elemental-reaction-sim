@@ -0,0 +1,56 @@
+package combat
+
+import (
+	"fmt"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+
+type sourceHostPhaseProvider interface {
+	SourceHostPhaseState() (map[string]any, []string)
+}
+
+func sourceHostTargetPhase(target info.Target) (map[string]any, []string) {
+	if target == nil {
+		return nil, nil
+	}
+	typ := fmt.Sprintf("%T", target)
+	state := map[string]any{"concreteType": typ, "key": target.Key(), "targetType": target.Type()}
+	gaps := []string{}
+	if provider, ok := target.(sourceHostPhaseProvider); ok {
+		value, missing := provider.SourceHostPhaseState()
+		state["state"] = value
+		gaps = append(gaps, missing...)
+	} else {
+		state["alive"] = target.IsAlive()
+		state["position"] = target.Pos()
+		gaps = append(gaps, "target-provider-missing:"+typ)
+	}
+	// Embedded Target/Gadget providers cannot prove a concrete subtype's private
+	// continuation state. Explicitly audited types are the only exceptions.
+	switch typ {
+	case "*enemy.Enemy", "*avatar.Player", "*gadget.Gadget":
+	default:
+		gaps = append(gaps, "target-subtype-private-state:"+typ)
+	}
+	return state, gaps
+}
+
+func (h *Handler) SourceHostPhaseState() (map[string]any, []string) {
+	gaps := []string{}
+	capture := func(target info.Target, path string) map[string]any {
+		state, missing := sourceHostTargetPhase(target)
+		for _, gap := range missing {
+			gaps = append(gaps, path+"."+gap)
+		}
+		return state
+	}
+	enemies := make([]map[string]any, len(h.enemies))
+	for i, target := range h.enemies {
+		enemies[i] = capture(target, fmt.Sprintf("enemies[%d]", i))
+	}
+	gadgets := make([]map[string]any, len(h.gadgets))
+	for i, target := range h.gadgets {
+		gadgets[i] = capture(target, fmt.Sprintf("gadgets[%d]", i))
+	}
+	return map[string]any{"enemies": enemies, "gadgets": gadgets, "player": capture(h.player, "player"), "defaultTarget": h.DefaultTarget, "nextTargetKey": h.keycount, "gadgetCollectionTick": h.gccount, "damageMode": h.DamageMode, "defenseHalt": h.DefHalt, "hitlagEnabled": h.EnableHitlag}, gaps
+}
