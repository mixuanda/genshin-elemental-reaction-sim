+package gadget
+
+func (g *Gadget) SourceHostPhaseState() (map[string]any, []string) {
+	target, gaps := g.Target.SourceHostPhaseState()
+	state := map[string]any{"target": target, "type": g.gadgetTyp, "generationAgeFrames": g.core.F - g.src, "durationRemainingFrames": g.Duration, "thinkIntervalFrames": g.ThinkInterval, "sinceLastThinkFrames": g.sinceLastThink, "hasOnKill": g.OnKill != nil, "hasOnExpiry": g.OnExpiry != nil, "hasOnThink": g.OnThinkInterval != nil}
+	if g.OnKill != nil {
+		gaps = append(gaps, "gadget.on-kill-captured-state")
+	}
+	if g.OnExpiry != nil {
+		gaps = append(gaps, "gadget.on-expiry-captured-state")
+	}
+	if g.OnThinkInterval != nil {
+		gaps = append(gaps, "gadget.on-think-captured-state")
+	}
+	return state, gaps
+}
