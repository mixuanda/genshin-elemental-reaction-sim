+// SourceHostBonusCallbacks records this getter without importing sourcehost.
+// BeginDamage/EndDamage scope the read around all shield applications of a hit.
+type SourceHostBonusCallbacks struct {
+	BeginDamage  func()
+	EndDamage    func()
+	NewRead      func() *info.SourceHostScalarRead
+	CompleteRead func(*info.SourceHostScalarRead)
+	BeginStep    func(*info.SourceHostScalarStep)
+	EndStep      func(*info.SourceHostScalarStep)
+}
+
 // TODO: this probably should be affected by hitlag as well
 func (h *Handler) ShieldBonus() float64 {
+	var read *info.SourceHostScalarRead
+	if h.SourceHostBonus.NewRead != nil {
+		read = h.SourceHostBonus.NewRead()
+	}
 	n := 0
 	amt := 0.0
 	for _, mod := range h.shieldBonusMods {
+		var step *info.SourceHostScalarStep
+		if read != nil {
+			step = &info.SourceHostScalarStep{
+				Index: len(read.Steps), Key: mod.Key, ExpiryBefore: mod.Expiry, ExpiryAfter: mod.Expiry,
+				AffectedByHitlag: false, Element: "", ClosureOpaque: true,
+				Before: amt, After: amt, Dependencies: []*info.SourceHostStatRead{},
+			}
+			read.Steps = append(read.Steps, step)
+		}
 		if mod.Expiry > *h.f || mod.Expiry == -1 {
+			if step != nil {
+				h.SourceHostBonus.BeginStep(step)
+			}
 			a, done := mod.Amount()
+			if step != nil {
+				h.SourceHostBonus.EndStep(step)
+			}
 			amt += a
+			if step != nil {
+				delta := a
+				step.Outcome, step.Delta, step.After = "applied", &delta, amt
+			}
 			if !done {
 				h.shieldBonusMods[n] = mod
 				n++
 			}
+		} else if step != nil {
+			step.Outcome = "expired"
 		}
 	}
 	h.shieldBonusMods = h.shieldBonusMods[:n]
+	if read != nil {
+		read.Sum, read.Output = amt, amt
+		h.SourceHostBonus.CompleteRead(read)
+	}
 	return amt
 }
 
