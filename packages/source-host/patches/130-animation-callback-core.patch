diff --git a/pkg/core/action/sourcehost_animation_funcs.go b/pkg/core/action/sourcehost_animation_funcs.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/action/sourcehost_animation_funcs.go
@@ -0,0 +1,36 @@
+package action
+
+import "github.com/genshinsim/gcsim/pkg/core/phase"
+
+// RemovedFunc retains the real callback and the source-audited description of
+// its complete captures together. Replacing it replaces both values.
+type RemovedFunc struct {
+	Run   func(next AnimationState)
+	Phase *phase.Descriptor
+}
+
+// NormalizedTimeFunc describes the predicate without evaluating it at a marker.
+type NormalizedTimeFunc struct {
+	Run   func(next Action) bool
+	Phase *phase.Descriptor
+}
+
+// OpaqueRemovedFunc preserves an unreviewed callback and its explicit gap.
+func OpaqueRemovedFunc(f func(next AnimationState)) RemovedFunc { return RemovedFunc{Run: f} }
+
+// OpaqueNormalizedTimeFunc never assumes that a dynamic predicate is stateless.
+func OpaqueNormalizedTimeFunc(f func(next Action) bool) NormalizedTimeFunc {
+	return NormalizedTimeFunc{Run: f}
+}
+
+// NormalizedForNextAction binds the audited next == nextAction predicate and its
+// sole scalar capture. The original HuTao/Keqing assignment conditions remain
+// at their action sites; no character-specific predicate is evaluated here.
+func NormalizedForNextAction(nextAction Action) NormalizedTimeFunc {
+	return NormalizedTimeFunc{
+		Run: func(next Action) bool { return next == nextAction },
+		Phase: &phase.Descriptor{Source: "pkg/core/action/sourcehost_animation_funcs.go:NormalizedForNextAction", Observe: func() (map[string]any, []string) {
+			return map[string]any{"nextAction": nextAction.String()}, nil
+		}},
+	}
+}
