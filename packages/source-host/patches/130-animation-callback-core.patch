diff --git a/pkg/core/player/character/sourcehost_captured_phase.go b/pkg/core/player/character/sourcehost_captured_phase.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/player/character/sourcehost_captured_phase.go
@@ -0,0 +1,16 @@
+package character
+
+import "fmt"
+
+// SourceHostCapturedImplementationPhase reads the actual implementation object
+// retained by an audited callback. The caller supplies that object explicitly;
+// neither a source label nor an actor index alone proves the closure's captures.
+// This uses the same read-only private reader as the character phase provider,
+// including every existing unknown function, clock, or generation-token gap.
+func (c *CharWrapper) SourceHostCapturedImplementationPhase(object any) (map[string]any, []string) {
+	state, gaps := sourceHostPrivatePhaseState(object, fmt.Sprintf("character[%d].capturedImplementation", c.index), *c.f)
+	return map[string]any{
+		"actor":          map[string]any{"sharedStateOwner": "characterWrapper", "characterIndex": c.index},
+		"implementation": state,
+	}, gaps
+}
