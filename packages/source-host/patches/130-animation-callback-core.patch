+package character
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/action"
+	"github.com/genshinsim/gcsim/pkg/core/phase"
+)
+
+// SourceHostRemovedFunc is only for source-audited callbacks whose sole capture
+// is the explicitly supplied implementation object. The original callback is
+// retained unchanged; phase observation reads the same object, never the hook.
+// Callbacks retaining additional locals or closures must stay opaque or supply
+// a separate complete descriptor. Unknown actor state remains an explicit gap.
+func (c *Character) SourceHostRemovedFunc(source string, implementation any, run func(next action.AnimationState)) action.RemovedFunc {
+	return action.RemovedFunc{
+		Run: run,
+		Phase: &phase.Descriptor{Source: source, Observe: func() (map[string]any, []string) {
+			return c.SourceHostCapturedImplementationPhase(implementation)
+		}},
+	}
+}
