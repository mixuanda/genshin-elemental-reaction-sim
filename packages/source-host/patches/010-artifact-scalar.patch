 func (c *CharWrapper) finishSourceHostStatStep(step *info.SourceHostStatStep, outcome string, returned []float64, after attributes.Stats, expiry int) {
 	if step == nil { return }
+	c.SourceHost.EndStatFormulaStep(step)
 	step.Outcome, step.Returned, step.After, step.ExpiryAfter = outcome, returned, after, expiry
 }
 
 // Capture only real stat reads nested inside this particular ReactBonus Amount.
 func (c *CharWrapper) beginSourceHostScalarStep(step *info.SourceHostScalarStep) {
 	if step == nil { return }
+	c.SourceHost.BeginScalarFormulaStep(step)
 	c.sourceHostScalarSteps = append(c.sourceHostScalarSteps, step)
 	c.sourceHostScalarStatDepths = append(c.sourceHostScalarStatDepths, len(c.sourceHostStatStack))
 }
 func (c *CharWrapper) endSourceHostScalarStep(step *info.SourceHostScalarStep) {
 	if step == nil { return }
+	c.SourceHost.EndScalarFormulaStep(step)
 	c.sourceHostScalarSteps = c.sourceHostScalarSteps[:len(c.sourceHostScalarSteps)-1]
 	c.sourceHostScalarStatDepths = c.sourceHostScalarStatDepths[:len(c.sourceHostScalarStatDepths)-1]
 }
