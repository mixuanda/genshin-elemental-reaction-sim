+// triggerWithStatusOwner binds the active status instance only for work
+// created by this trigger. The Init-installed callback ancestry and the
+// later normal-attack trigger remain independent in the origin record.
+func (w *Watcher) triggerWithStatusOwner() {
+	if w.core.SourceHost == nil {
+		w.triggerFunc()
+		return
+	}
+	end := w.core.SourceHost.Origin.BeginStatusOwner(w.caster.SourceHostStatusOwner(w.statusKey))
+	w.triggerFunc()
+	end()
 }
 
