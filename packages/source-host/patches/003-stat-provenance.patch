+++ b/pkg/core/player/character/sourcehost_stat_provenance.go
@@ -0,0 +1,59 @@
+package character
+
+import (
+	"fmt"
+	"github.com/genshinsim/gcsim/pkg/core/attributes"
+	"github.com/genshinsim/gcsim/pkg/core/info"
+)
+
+func (c *CharWrapper) beginSourceHostStatRead(kind string, base attributes.Stats, selector []attributes.Stat, nonExtra bool) *info.SourceHostStatRead {
+	if c.SourceHost == nil { return nil }
+	c.sourceHostStatSequence++
+	read := &info.SourceHostStatRead{
+		ID: fmt.Sprintf("actor-%d-read-%d", c.index, c.sourceHostStatSequence), Kind: kind,
+		Frame: *c.f, ActorIndex: c.index, Selector: append([]attributes.Stat{}, selector...), NonExtra: nonExtra,
+		Base: base, Result: base, Steps: []*info.SourceHostStatStep{},
+	}
+	if len(c.sourceHostStatStack) > 0 {
+		parent := c.sourceHostStatStack[len(c.sourceHostStatStack)-1]
+		if len(parent.Steps) > 0 {
+			step := parent.Steps[len(parent.Steps)-1]
+			step.Dependencies = append(step.Dependencies, read)
+		}
+	}
+	c.sourceHostStatStack = append(c.sourceHostStatStack, read)
+	return read
+}
+
+func (c *CharWrapper) endSourceHostStatRead(read *info.SourceHostStatRead) {
+	if read != nil { c.sourceHostStatStack = c.sourceHostStatStack[:len(c.sourceHostStatStack)-1] }
+}
+
+func (c *CharWrapper) beginSourceHostStatStep(read *info.SourceHostStatRead, mod *StatMod, before attributes.Stats) *info.SourceHostStatStep {
+	if read == nil { return nil }
+	step := &info.SourceHostStatStep{
+		Index: len(read.Steps), Key: mod.Key(), ExpiryBefore: mod.Expiry(), ExpiryAfter: mod.Expiry(),
+		AffectedStat: int(mod.AffectedStat), Extra: mod.Extra, AffectedByHitlag: mod.AffectedByHitlag(),
+		Before: before, AfterAmount: before, After: before,
+		AttackChanges: []info.SourceHostNumericChange{}, Dependencies: []*info.SourceHostStatRead{},
+	}
+	read.Steps = append(read.Steps, step)
+	return step
+}
+
+func (c *CharWrapper) beginSourceHostAttackStatStep(read *info.SourceHostStatRead, mod *AttackMod, before attributes.Stats) *info.SourceHostStatStep {
+	if read == nil { return nil }
+	step := &info.SourceHostStatStep{
+		Index: len(read.Steps), Key: mod.Key(), ExpiryBefore: mod.Expiry(), ExpiryAfter: mod.Expiry(),
+		AffectedStat: int(attributes.NoStat), AffectedByHitlag: mod.AffectedByHitlag(),
+		Before: before, AfterAmount: before, After: before,
+		AttackChanges: []info.SourceHostNumericChange{}, Dependencies: []*info.SourceHostStatRead{},
+	}
+	read.Steps = append(read.Steps, step)
+	return step
+}
+
+func (c *CharWrapper) finishSourceHostStatStep(step *info.SourceHostStatStep, outcome string, returned []float64, after attributes.Stats, expiry int) {
+	if step == nil { return }
+	step.Outcome, step.Returned, step.After, step.ExpiryAfter = outcome, returned, after, expiry
+}
