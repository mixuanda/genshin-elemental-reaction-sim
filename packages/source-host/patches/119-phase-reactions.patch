+package enemy
+
+import "github.com/genshinsim/gcsim/pkg/core/phase"
+
+// QueueEnemyTaskWithPhase adds read-only capture metadata to the same native
+// enemy queue. The immediate path and enemy-local clock match QueueEnemyTask.
+func (e *Enemy) QueueEnemyTaskWithPhase(f func(), delay int, key string, descriptor phase.Descriptor) {
+	if delay == 0 {
+		f()
+		return
+	}
+	e.queue.AddWithPhase(f, delay, key, descriptor)
+}
