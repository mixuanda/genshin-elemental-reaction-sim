+
+// Keep the native Enemy interface unchanged: other implementations still use
+// their original queue and retain an explicit phase-observation gap.
+type sourceHostPhaseEnemyTasker interface {
+	QueueEnemyTaskWithPhase(func(), int, string, phase.Descriptor)
+}
+
+func sourceHostQueueEnemyTaskWithPhase(t Enemy, f func(), delay int, key string, descriptor phase.Descriptor) {
+	if described, ok := t.(sourceHostPhaseEnemyTasker); ok {
+		described.QueueEnemyTaskWithPhase(f, delay, key, descriptor)
+		return
+	}
+	t.QueueEnemyTask(f, delay)
+}
+
+func (r *Reactable) sourceHostPhaseTargetReference() map[string]any {
+	return map[string]any{"targetKey": r.self.Key(), "targetType": r.self.Type()}
+}
+
+func (r *Reactable) sourceHostQueueECTick(src, delay int) {
+	r.core.Tasks.AddWithPhase(r.nextECTick(src), delay, "reaction-electrocharged-tick", phase.Descriptor{
+		Source: "pkg/reactable/electrocharged.go:nextECTick",
+		Observe: func() (map[string]any, []string) {
+			state := r.sourceHostPhaseTargetReference()
+			state["capturedGenerationAgeFrames"] = r.core.F - src
+			state["matchesLiveGeneration"] = r.ecTickSrc == src
+			return state, nil
+		},
+	})
+}
+
+func (r *Reactable) sourceHostPhaseECWaneEvent(removalType event.Event, removalKey string) phase.Descriptor {
+	return phase.Descriptor{
+		Source: "pkg/reactable/electrocharged.go:TryAddEC:wane-event",
+		Observe: func() (map[string]any, []string) {
+			state := r.sourceHostPhaseTargetReference()
+			state["removalEventType"] = removalType
+			state["removalEventKey"] = removalKey
+			return state, nil
+		},
+	}
+}
+
+func (r *Reactable) sourceHostPhaseECWane() phase.Descriptor {
+	return phase.Descriptor{
+		Source: "pkg/reactable/electrocharged.go:TryAddEC:wane-task",
+		Observe: func() (map[string]any, []string) {
+			// This callback captures only r, not the EC generation or event args.
+			return r.sourceHostPhaseTargetReference(), nil
+		},
+	}
+}
+
+func (r *Reactable) sourceHostQueueBurningTick(src, counter int, t Enemy) {
+	// These are the exact values supplied to the queued callback. It mutates
+	// counter only after being removed from the pending queue; the next task
+	// receives the original callback's incremented counter as its own capture.
+	descriptor := phase.Descriptor{
+		Source: "pkg/reactable/burning.go:nextBurningTick",
+		Observe: func() (map[string]any, []string) {
+			state := r.sourceHostPhaseTargetReference()
+			state["capturedGenerationAgeFrames"] = r.core.F - src
+			state["matchesLiveGeneration"] = r.burningTickSrc == src
+			state["counter"] = counter
+			if target, ok := t.(info.Target); ok {
+				state["queueTargetKey"] = target.Key()
+				state["queueTargetType"] = target.Type()
+				return state, nil
+			}
+			return state, []string{"burning-queue-target-identity"}
+		},
+	}
+	sourceHostQueueEnemyTaskWithPhase(t, r.nextBurningTick(src, counter, t), 15, "reaction-burning-tick", descriptor)
+}
