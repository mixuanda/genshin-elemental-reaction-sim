+// Package phase describes callbacks for read-only source-host phase observation.
+// The descriptor is metadata only; it never changes callback execution.
+package phase
+
+type Descriptor struct {
+	// Source identifies the audited registration or queue site, not a key prefix.
+	Source string
+	// Observe reads the callback's live captured values without invoking it.
+	// An empty map explicitly means that the audited callback is stateless.
+	Observe func() (map[string]any, []string)
+	// Observational is reserved for source-audited callbacks that cannot change
+	// gameplay state, scheduling, or random draws, and whose key slot cannot
+	// later be reused by a gameplay callback. These do not enter phase equality.
+	Observational bool
+}
