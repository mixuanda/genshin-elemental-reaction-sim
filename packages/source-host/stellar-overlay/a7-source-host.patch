+package info
+
+import "github.com/genshinsim/gcsim/pkg/core/attributes"
+
+// This is a numerical execution receipt, not a serialized modifier closure.
+type SourceHostStatRead struct {
+	ID string `json:"id"`
+	Kind string `json:"kind"`
+	Frame int `json:"frame"`
+	ActorIndex int `json:"actorIndex"`
+	TargetKey *int `json:"targetKey,omitempty"`
+	Selector []attributes.Stat `json:"selector"`
+	NonExtra bool `json:"nonExtra"`
+	Base attributes.Stats `json:"base"`
+	Steps []*SourceHostStatStep `json:"steps"`
+	Result attributes.Stats `json:"result"`
+}
+
+type SourceHostStatStep struct {
+	Index int `json:"index"`
+	Key string `json:"key"`
+	ExpiryBefore int `json:"expiryBefore"`
+	ExpiryAfter int `json:"expiryAfter"`
+	AffectedStat int `json:"affectedStat"`
+	Extra bool `json:"extra"`
+	AffectedByHitlag bool `json:"affectedByHitlag"`
+	Outcome string `json:"outcome"`
+	Before attributes.Stats `json:"before"`
+	AfterAmount attributes.Stats `json:"afterAmount"`
+	Returned []float64 `json:"returned"`
+	After attributes.Stats `json:"after"`
+	AttackChanges []SourceHostNumericChange `json:"attackChanges"`
+	Dependencies []*SourceHostStatRead `json:"dependencies"`
+}
+
+type SourceHostNumericChange struct {
+	Field string `json:"field"`
+	Before float64 `json:"before"`
+	After float64 `json:"after"`
+}
+
+type SourceHostStatProvenance struct {
+	Version string `json:"version"`
+	SnapshotRead *SourceHostStatRead `json:"snapshotRead"`
+	AttackReads []*SourceHostStatRead `json:"attackReads"`
+	FinalStats attributes.Stats `json:"finalStats"`
+}
