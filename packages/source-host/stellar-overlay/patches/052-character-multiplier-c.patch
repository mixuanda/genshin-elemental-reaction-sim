+
+// a4StellarGlimmerFormula runs at each original Mult write. The disabled
+// branch does not read ATK, matching the native ascension gate.
+func (c *char) a4StellarGlimmerFormula(base float64, a4Rule, noA4Rule string, prior float64, priorID int) (float64, int) {
+	if c.Core.SourceHost == nil {
+		return base * c.a4StellarGlimmerMult(), 0
+	}
+	if c.Base.Ascension < 4 {
+		return c.Core.SourceHost.CharacterMultiplierCompute(c.Index(), noA4Rule, prior,
+			map[string]any{"base": base}, nil, priorID)
+	}
+	totalAtk, read := c.TotalAtkWithProvenance()
+	return c.Core.SourceHost.CharacterMultiplierCompute(c.Index(), a4Rule, prior,
+		map[string]any{"base": base, "totalAtk": totalAtk}, []*info.SourceHostStatRead{read}, priorID)
+}
