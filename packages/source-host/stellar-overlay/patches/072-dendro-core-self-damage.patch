+// recordSelfDamageFlat preserves the already queued enemy hit, then records the
+// source's 2% self-hit write on this local AttackInfo and Snapshot only.
+func recordSelfDamageFlat(c *core.Core, ai *info.AttackInfo, snap *info.Snapshot) {
+	priorFlat := ai.FlatDmg
+	if c.SourceHost != nil {
+		priorComponents := c.SourceHost.CharacterFlatPrior(ai, snap)
+		value, id := c.SourceHost.CharacterFlatCompute(ai.ActorIndex,
+			"char-flat-dendrocore-self-hit", priorFlat, map[string]any{}, nil, snap, priorComponents)
+		ai.FlatDmg = value
+		c.SourceHost.CharacterFlatAttach(ai, snap, id, value)
+		return
+	}
+	ai.FlatDmg = 0.02 * priorFlat
+}
