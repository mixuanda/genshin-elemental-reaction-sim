@@ -0,0 +1,16 @@
+package yelan
+
+import "github.com/genshinsim/gcsim/pkg/core/info"
+
+// recordSourceFlat replaces this exact native FlatDmg write with the shared
+// result, retaining the already evaluated native value when no host is attached.
+func (c *char) recordSourceFlat(ai *info.AttackInfo, snap *info.Snapshot, rule string, prior float64, state map[string]any, read *info.SourceHostStatRead) {
+	if c.Core.SourceHost == nil {
+		return
+	}
+	host := c.Core.SourceHost
+	value, id := host.CharacterFlatCompute(c.Index(), rule, prior, state,
+		[]*info.SourceHostStatRead{read}, snap, host.CharacterFlatPrior(ai, snap))
+	ai.FlatDmg = value
+	host.CharacterFlatAttach(ai, snap, id, value)
+}
