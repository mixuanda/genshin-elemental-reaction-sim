+++ b/internal/frames/sourcehost_phase_frames.go
@@ -0,0 +1,27 @@
+package frames
+
+import "github.com/genshinsim/gcsim/pkg/core/phase"
+
+// Observe the table captured by the original closure; copy at observation time
+// so a later table edit cannot mutate an already-exported boundary. No Stat or
+// gameplay callback is evaluated here, and the original slice alias is retained.
+func sourceHostAbilityFrames(kind string, table []int, offset int) *phase.Descriptor {
+	return &phase.Descriptor{Source: "internal/frames/frames.go:" + kind,
+		Observe: func() (map[string]any, []string) {
+			return map[string]any{"frameTable": append([]int{}, table...), "offset": offset}, nil
+		},
+	}
+}
+
+func sourceHostAttackFrames(kind string, table [][]int, normalCounter int, attackSpeed float64, offset int) *phase.Descriptor {
+	return &phase.Descriptor{Source: "internal/frames/frames.go:" + kind,
+		Observe: func() (map[string]any, []string) {
+			copied := make([][]int, len(table))
+			for index := range table {
+				copied[index] = append([]int{}, table[index]...)
+			}
+			return map[string]any{"frameTable": copied, "normalCounter": normalCounter,
+				"attackSpeed": attackSpeed, "offset": offset}, nil
+		},
+	}
+}
