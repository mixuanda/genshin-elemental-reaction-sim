diff --git a/pkg/core/action/sourcehost_frame_func.go b/pkg/core/action/sourcehost_frame_func.go
new file mode 100644
--- /dev/null
+++ b/pkg/core/action/sourcehost_frame_func.go
@@ -0,0 +1,25 @@
+package action
+
+import "github.com/genshinsim/gcsim/pkg/core/phase"
+
+// FrameFunc keeps the actual callback and its captured-state descriptor together.
+// Replacing an animation rule replaces its descriptor as well.
+type FrameFunc struct {
+	Run   func(next Action) int
+	Phase *phase.Descriptor
+}
+
+// OpaqueFrameFunc preserves custom callbacks without claiming to describe them.
+func OpaqueFrameFunc(f func(next Action) int) FrameFunc { return FrameFunc{Run: f} }
+
+// BindSourceHostDefaultPause annotates the shared native fallback at its only
+// assignment site. Custom callbacks supplied by actions never pass through here.
+func (a *Info) BindSourceHostDefaultPause(actorIndex int, paused func() bool) {
+	a.FramePausedOnHitlag = paused
+	a.sourceHostPausePhase = &phase.Descriptor{
+		Source: "pkg/core/player/character/hitlag.go:FramePausedOnHitlag",
+		Observe: func() (map[string]any, []string) {
+			return map[string]any{"actorIndex": actorIndex, "predicate": "character.frozenFrames > 0"}, nil
+		},
+	}
+}
