+package mavuika
+
+import "github.com/genshinsim/gcsim/pkg/core/info"
+
+// setBikeFlat follows the original left-to-right helper order. Each live ATK
+// getter has its own provenance receipt; a skipped branch never reads ATK.
+func (c *char) setBikeFlat(ai *info.AttackInfo, kind string) {
+	var leftRule, zeroRule, rightRule string
+	switch kind {
+	case "normal":
+		leftRule, zeroRule, rightRule = "char-flat-mavuika-normal-burst", "char-flat-mavuika-normal-zero", "char-flat-mavuika-normal-c2"
+	case "sunfell":
+		leftRule, zeroRule, rightRule = "char-flat-mavuika-sunfell-burst", "char-flat-mavuika-sunfell-zero", "char-flat-mavuika-sunfell-c2"
+	case "final":
+		leftRule, zeroRule, rightRule = "char-flat-mavuika-final-burst", "char-flat-mavuika-final-zero", "char-flat-mavuika-final-c2"
+	case "cyclic":
+		leftRule, zeroRule, rightRule = "char-flat-mavuika-cyclic-burst", "char-flat-mavuika-cyclic-zero", "char-flat-mavuika-cyclic-c2"
+	}
+	if c.Core.SourceHost == nil {
+		switch kind {
+		case "normal":
+			ai.FlatDmg = c.burstBuffNA() + c.c2BikeNA()
+		case "sunfell":
+			ai.FlatDmg = c.burstBuffSunfell() + c.c2BikeQ()
+		case "final", "cyclic":
+			ai.FlatDmg = c.burstBuffCA() + c.c2BikeCA()
+		}
+		return
+	}
+	host := c.Core.SourceHost
+	if c.StatusIsActive(burstKey) {
+		stacks := c.burstStacks
+		level := c.TalentLvlBurst()
+		atk, read := c.TotalAtkWithProvenance()
+		prior := host.CharacterFlatPrior(ai, nil)
+		value, id := host.CharacterFlatCompute(c.Index(), leftRule, ai.FlatDmg,
+			map[string]any{"burstStacks": stacks, "talentLevel": level, "totalAtk": atk},
+			[]*info.SourceHostStatRead{read}, nil, prior)
+		ai.FlatDmg = value
+		host.CharacterFlatAttach(ai, nil, id, value)
+	} else {
+		prior := host.CharacterFlatPrior(ai, nil)
+		value, id := host.CharacterFlatCompute(c.Index(), zeroRule, ai.FlatDmg,
+			map[string]any{}, nil, nil, prior)
+		ai.FlatDmg = value
+		host.CharacterFlatAttach(ai, nil, id, value)
+	}
+	if c.Base.Cons < 2 {
+		return
+	}
+	if c.armamentState != bike {
+		return
+	}
+	atk, read := c.TotalAtkWithProvenance()
+	prior := host.CharacterFlatPrior(ai, nil)
+	value, id := host.CharacterFlatCompute(c.Index(), rightRule, ai.FlatDmg,
+		map[string]any{"totalAtk": atk}, []*info.SourceHostStatRead{read}, nil, prior)
+	ai.FlatDmg = value
+	host.CharacterFlatAttach(ai, nil, id, value)
+}
