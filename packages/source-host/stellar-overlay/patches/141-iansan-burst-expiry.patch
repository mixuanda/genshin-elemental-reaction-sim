+
+// Follow the actual marker expiry, including any native hitlag extension.
+// The global clock avoids delaying cleanup on a frozen character task queue.
+// Native status expiry is inclusive, so cleanup runs at expiry + 1.
+func (c *char) burstExpiryTask(src int) {
+	c.Core.Tasks.Add(func() {
+		if c.burstSrc != src {
+			return
+		}
+		if c.StatusIsActive(burstStatus) {
+			c.burstExpiryTask(src)
+			return
+		}
+		c.exitNightsoul()
+	}, c.StatusDuration(burstStatus)+1)
 }
 
