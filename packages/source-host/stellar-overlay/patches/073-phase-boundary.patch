diff --git a/pkg/gcs/eval/sourcehost_phase.go b/pkg/gcs/eval/sourcehost_phase.go
new file mode 100644
index 0000000..6b86d32
--- /dev/null
+++ b/pkg/gcs/eval/sourcehost_phase.go
@@ -0,0 +1,132 @@
+package eval
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math"
+	"regexp"
+	"strings"
+
+	"github.com/genshinsim/gcsim/pkg/core/action"
+	"github.com/genshinsim/gcsim/pkg/gcs/ast"
+)
+
+// These native builtins can make future input depend on absolute time,
+// random draws, or an asynchronous evaluator closure. In that case an
+// observed matching label/environment does not prove repeat input control.
+var sourceHostDynamicInput = regexp.MustCompile(`(^|[^[:alnum:]_])(f|rand|randnorm|set_on_tick)[[:space:]]*\(`)
+
+func (e *Eval) sourceHostPhase(c *ast.CallExpr, env *Env) (Obj, error) {
+	objects, err := e.validateArguments(c, env, typStr)
+	if err != nil {
+		return nil, err
+	}
+	label := strings.TrimSpace(objects[0].(*strval).str)
+	if label == "" {
+		return nil, ast.NewErrorf(e.file.Position(c.Pos), "phase repeat ID must not be empty")
+	}
+	position := int(c.Pos)
+	key := fmt.Sprintf("%d:%s", position, label)
+	e.phaseOccurrences[key]++
+	inputState, gaps := e.sourceHostInputState(env, position)
+	encoded, err := json.Marshal(inputState)
+	if err != nil {
+		gaps = append(gaps, "native evaluator environment could not be serialized")
+	}
+	digest := sha256.Sum256(encoded)
+	signature := hex.EncodeToString(digest[:])
+	seenKey := key + ":" + signature
+	verifiedRepeat := len(gaps) == 0 && e.phaseSignatures[seenKey]
+	if len(gaps) == 0 {
+		e.phaseSignatures[seenKey] = true
+	}
+	e.sendWork(&action.Eval{Action: action.ActionPhase, Phase: &action.PhaseMarker{
+		RepeatID: label, Position: position, Iteration: e.phaseOccurrences[key],
+		FutureInputSignature: signature, VerifiedRepeat: verifiedRepeat,
+		InputState: inputState, InputGaps: gaps,
+	}})
+	if err := e.waitForNext(); err != nil {
+		return nil, err
+	}
+	return &null{}, nil
+}
+
+// The full lexical chain is captured at the actual native callsite. A
+// function closure or unhandled object makes the input phase noncomparable.
+func (e *Eval) sourceHostInputState(env *Env, position int) (map[string]any, []string) {
+	program := sha256.Sum256([]byte(e.AST.String()))
+	state := map[string]any{
+		"programSha256":    hex.EncodeToString(program[:]),
+		"callsitePosition": position,
+		"functionDepth":    e.phaseFunctionDepth,
+	}
+	var gaps []string
+	if e.phaseFunctionDepth != 0 {
+		gaps = append(gaps, "phase marker is inside a user function; caller continuation is not captured")
+	}
+	if sourceHostDynamicInput.MatchString(e.AST.String()) {
+		gaps = append(gaps, "GCSL program contains frame, random, or on-tick input query")
+	}
+	var chain []*Env
+	for scope := env; scope != nil; scope = scope.parent {
+		chain = append(chain, scope)
+	}
+	scopes := make([]any, 0, len(chain))
+	for depth := len(chain) - 1; depth >= 0; depth-- {
+		values := make(map[string]any)
+		for name, pointer := range chain[depth].varMap {
+			if pointer == nil || *pointer == nil {
+				gaps = append(gaps, "nil evaluator variable "+name)
+				continue
+			}
+			if _, builtin := (*pointer).(*bfuncval); builtin {
+				if depth != len(chain)-1 {
+					gaps = append(gaps, "aliased builtin evaluator function "+name)
+				}
+				continue
+			}
+			values[name] = sourceHostPhaseValue(*pointer, name, map[*mapval]bool{}, &gaps)
+		}
+		scopes = append(scopes, values)
+	}
+	state["lexicalScopes"] = scopes
+	return state, gaps
+}
+
+func sourceHostPhaseValue(value Obj, path string, visiting map[*mapval]bool, gaps *[]string) any {
+	switch current := value.(type) {
+	case *null:
+		return nil
+	case *number:
+		if current.isFloat {
+			if math.IsNaN(current.fval) || math.IsInf(current.fval, 0) {
+				*gaps = append(*gaps, "non-finite evaluator variable "+path)
+				return "non-finite"
+			}
+			return map[string]any{"type": "float", "value": current.fval}
+		}
+		return map[string]any{"type": "integer", "value": current.ival}
+	case *strval:
+		return current.str
+	case *mapval:
+		if visiting[current] {
+			*gaps = append(*gaps, "cyclic evaluator map "+path)
+			return "cyclic-map"
+		}
+		visiting[current] = true
+		fields := make(map[string]any, len(current.fields))
+		for key, nested := range current.fields {
+			fields[key] = sourceHostPhaseValue(nested, path+"."+key, visiting, gaps)
+		}
+		delete(visiting, current)
+		return fields
+	case *funcval:
+		*gaps = append(*gaps, "user function closure "+path+" is not fully captured")
+		return map[string]any{"type": "function", "bodyPosition": int(current.Body.Pos)}
+	default:
+		*gaps = append(*gaps, "unsupported evaluator variable "+path)
+		return map[string]any{"type": fmt.Sprintf("%T", value)}
+	}
+}
