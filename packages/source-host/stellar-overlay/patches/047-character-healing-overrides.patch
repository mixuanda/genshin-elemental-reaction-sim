diff --git a/internal/characters/arlecchino/arlecchino.go b/internal/characters/arlecchino/arlecchino.go
--- a/internal/characters/arlecchino/arlecchino.go
+++ b/internal/characters/arlecchino/arlecchino.go
@@ -79,7 +79,21 @@
 func (c *char) ReceiveHeal(hi *info.HealInfo, healAmt float64) float64 {
 	// ignore all healing except hers
 	if hi.Caller == c.Index() && hi.Message == balemoonRisingHealAbil {
+		if c.Core.SourceHost != nil {
+			delegated, id := c.Core.SourceHost.CharacterHealing(c.Index(), hi.Message,
+				map[string]any{"operation": "receive-delegation", "branch": "arlecchino-own-burst", "finalAmount": healAmt},
+				nil, nil, []int{c.Core.SourceHost.CurrentHealingAmountID()})
+			c.Core.SourceHost.RecordHealingDelegation(id)
+			healAmt = delegated
+		}
 		return c.Character.ReceiveHeal(hi, healAmt)
+	}
+	if c.Core.SourceHost != nil {
+		received, id := c.Core.SourceHost.CharacterHealing(c.Index(), hi.Message,
+			map[string]any{"operation": "receive-override", "branch": "arlecchino-rejected", "finalAmount": healAmt},
+			nil, nil, []int{c.Core.SourceHost.CurrentHealingAmountID()})
+		c.Core.SourceHost.RecordHealingReceive(id)
+		return received
 	}
 	return 0
 }
