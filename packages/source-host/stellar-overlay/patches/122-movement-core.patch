new file mode 100644
--- /dev/null
+++ b/pkg/core/player/sourcehost_phase_movement.go
@@ -0,0 +1,25 @@
+package player
+
+import (
+	"github.com/genshinsim/gcsim/pkg/core/action"
+	"github.com/genshinsim/gcsim/pkg/core/keys"
+	"github.com/genshinsim/gcsim/pkg/core/phase"
+)
+
+func (h *Handler) sourceHostSwapFrames() action.FrameFunc {
+	return action.FrameFunc{
+		Run: func(action.Action) int { return h.Delays.Swap },
+		Phase: &phase.Descriptor{Source: "pkg/core/player/exec.go:swap:frames", Observe: func() (map[string]any, []string) {
+			return map[string]any{"swapFrames": h.Delays.Swap}, nil
+		}},
+	}
+}
+
+// The native swap callback reads player and character state at execution time.
+// Those providers export the live active actor, cooldowns and normal counters;
+// this descriptor adds the closure's destination and its live index mapping.
+func (h *Handler) sourceHostSwapPhase(to keys.Char) phase.Descriptor {
+	return phase.Descriptor{Source: "pkg/core/player/player.go:swap", Observe: func() (map[string]any, []string) {
+		return map[string]any{"destinationCharacter": to.String(), "destinationIndex": h.charPos[to]}, nil
+	}}
+}
