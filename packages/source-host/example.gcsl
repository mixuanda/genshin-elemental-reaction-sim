# Source-host demonstration with a hypothetical equipment-derived build.
# Extra stats below are supplied contributions, not an imported final panel.
# This is not a verified build, benchmark, or claim of game verification.
# Target HP is omitted deliberately: an explicit hp switches this source to damage mode.
options iteration=1 duration=8;

amber char lvl=90/90 cons=0 talent=1,1,1;
amber add weapon="favoniuswarbow" refine=1 lvl=90/90;
amber add stats atk=200 atk%=0.4 cr=0.2 cd=0.4;

target lvl=90 resist=0.1 radius=2 pos=0,2.4;
active amber;

amber attack:5;
