# Editable teaching build and repeated input, not a verified benchmark.
# The phase marker records state; it does not advance time or cause an action.
options iteration=1 duration=16;
amber char lvl=90/90 cons=0 talent=1,1,1;
amber add weapon="favoniuswarbow" refine=1 lvl=90/90;
amber add stats atk=200 atk%=0.4 cr=0.2 cd=0.4;
target lvl=90 resist=0.1 radius=2 pos=0,2.4;
active amber;
while 1 {
  phase("rotation");
  amber attack;
  wait(90);
}
