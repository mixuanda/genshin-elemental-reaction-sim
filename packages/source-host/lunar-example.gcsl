# Editable mechanism example, not a verified build or benchmark.
# All extra stats are explicit hypothetical build contributions, not final panels.
# Fixed source: b4ae769. The real aura/party/resource state chooses each reaction.
# The first phase isolates Geo/Hydro before adding Electro and then Dendro.
options iteration=1 duration=60;

columbina char lvl=90/90 cons=0 talent=1,1,1;
columbina add weapon="magicguide" refine=1 lvl=90/90;
columbina add stats hp=4000 hp%=0.3 em=100 cr=0.3 cd=0.5;
ningguang char lvl=90/90 cons=0 talent=1,1,1;
ningguang add weapon="magicguide" refine=1 lvl=90/90;
ningguang add stats atk=200 em=100 cr=0.2 cd=0.4;
ineffa char lvl=90/90 cons=0 talent=1,1,1;
ineffa add weapon="favoniuslance" refine=1 lvl=90/90;
ineffa add stats atk=200 em=100 cr=0.2 cd=0.4;
lauma char lvl=90/90 cons=0 talent=1,1,1;
lauma add weapon="magicguide" refine=1 lvl=90/90;
lauma add stats atk=200 em=100 cr=0.2 cd=0.4;

target lvl=90 resist=0.1 radius=2 pos=0,2.4;
active columbina;
columbina skill;
ningguang attack:18;
ineffa skill;
columbina attack:16;
columbina skill;
lauma skill;
columbina attack:6;
columbina charge:2;
wait(600);
