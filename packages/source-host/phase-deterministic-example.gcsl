# Editable pinned-source example, not an in-game verified benchmark.
# Both selected source revisions mark Venti's E HitWeakPoint=true and emit a
# fixed particle count. This example uses that native behavior without editing it.
# C0 and no Q leave the audited private burst state dormant. Dash updates the
# actual dash clock; cooldown, stamina, energy, animation and waits execute normally.
# No state, energy or random generator is reset between phase boundaries.
options iteration=1 duration=40;
venti char lvl=90/90 cons=0 talent=1,1,1;
venti add weapon="huntersbow" refine=1 lvl=90/90;
venti add stats atk=200 atk%=0.4 cr=0.2 cd=0.4;
target lvl=90 resist=0.1 radius=2 pos=0,2.4;
active venti;
while 1 {
  phase("rotation");
  venti skill;
  venti dash;
  wait(420);
}
