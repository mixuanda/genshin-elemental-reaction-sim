  "sourceBoundaries": [
    {
      "id": "periodic-checks-are-not-locked-mode",
      "sources": [
        "internal/characters/traveler/common/cryo/skill.go:105-118",
        "pkg/core/player/character/hitlag.go:10-34"
      ],
      "finding": "Each skill check re-reads current radiance. Stellar-Conduct skips the volley but keeps the next character task; C0 no-hitlag check offsets are 178,354,530,706."
    },
    {
      "id": "coordinated-inclusive-status-and-tail",
      "sources": [
        "internal/characters/traveler/common/cryo/skill.go:121-164",
        "pkg/modifier/modifier.go:117-125",
        "pkg/core/attack.go:64-96"
      ],
      "finding": "Coordinated callbacks require enemy target, current Stellar-Conduct and E status, and inactive 12-frame hitlag-aware ICD; equality remains active. Snapshot at callback+3 and damage at callback+3+travel are already queued without another state/owner-active check."
    },
    {
      "id": "q-lock-versus-hit-time-bonus",
      "sources": [
        "internal/characters/traveler/common/cryo/burst.go:49-95",
        "internal/characters/traveler/common/cryo/stellar.go:24-78",
        "pkg/enemy/damage.go:199-215"
      ],
      "finding": "Q locks radiance, Frostglow and hit count at its +36 character-task callback; each queued hit snapshots there. Separate Stellar base-damage bonus reads Traveler total ATK on hit, and direct Stellar-Conduct reads the attacker Polestar stack tag on hit."
    },
    {
      "id": "source-scope-not-game-verification",
      "sources": [
        "internal/characters/traveler/common/cryo/skill.go:32",
        "internal/characters/traveler/common/cryo/plunge.go:66-76",
        "internal/characters/traveler/common/cryo/plunge.go:123-134",
        "internal/characters/traveler/common/cryo/travelercryo.go:40-45"
      ],
      "finding": "Male E timing explicitly assumes female values; male plunge is not implemented and female plunge requires the Xianyun airborne state. True Moon defaults enabled unless explicitly disabled."
    },
    {
      "id": "polestar-expiry-subscriber-boundary",
      "sources": [
        "pkg/reactable/stellarconduct_gadget.go:57-89",
        "pkg/gadget/gadget.go:58-64",
        "pkg/core/combat/gadget.go:24-25"
      ],
      "finding": "Polestar listener unsubscribe is attached to OnKill, while natural expiry removes the gadget through OnExpiry without Kill; the fixed source may retain that listener. Retain as a source discrepancy, not a game-verified behavior."
    }
  ],
