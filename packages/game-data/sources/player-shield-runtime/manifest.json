  "sourceConflicts": [
    {
      "id": "geo-absorption-selector",
      "path": "pkg/core/player/shield/template.go",
      "lines": [
        48,
        53,
        59,
        64
      ],
      "finding": "ShieldStrength selects 1.5 by shield Geo element; actual OnDamage selects 1.5 by incoming Geo element. These are not equivalent."
    },
    {
      "id": "noelle-source-elements",
      "paths": [
        "internal/characters/noelle/shield.go",
        "internal/characters/noelle/asc.go",
        "pkg/core/attributes/element.go"
      ],
      "finding": "Noelle skill shield never sets Ele, leaving zero-valued Electro; Noelle A1 explicitly sets Cryo. Neither can silently certify a game-correct Geo shield."
    },
    {
      "id": "bonus-callback-done",
      "path": "pkg/core/player/shield/bonus.go",
      "lines": [
        16,
        21,
        23
      ],
      "finding": "A bonus callback returning done=true contributes to this read but is removed immediately; Zhongli/Thoma A1 and Geo resonance contain true-returning callbacks."
    },
    {
      "id": "expiry-equality-and-hitlag",
      "path": "pkg/core/player/shield/handler.go",
      "lines": [
        54,
        146,
        150
      ],
      "finding": "Only expiry==currentFrame is removed by Tick; damage has no independent expiry check. Hitlag handling is an explicit TODO."
    }
  ],
