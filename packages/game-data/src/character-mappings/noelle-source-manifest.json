  "scope": [
    "C0 ordinary base actions with burst inactive and no external infusion",
    "Charged cyclic and finisher are selected components, not a full held charged attack",
    "Low/high landing damage assumes no collision; collision remains separately selectable component",
    "Q cast covers exactly two source ordinary burst-tag hits using explicit actual ATK context, not subsequent normal inputs or a complete burst uptime rotation"
  ],
  "unverified": [
    "Source comments do not confirm exact Q snapshot and buff-start timings; fixed-source conditioned calculation only",
    "No automatic charge duration/stamina/cancel execution or airborne state reconstruction",
    "No automatic C4 shield explosion, C6 extension, healing or energy ledger from these standalone mappings"
  ],
  "qSnapshotSemantics": "Only TotalDef(true) is locked at Q input. Debug Snapshot return is discarded. Extra flat ATK conversion is active before both damage tasks, and each +24/+65 hit snapshots its then-current damage context independently."
