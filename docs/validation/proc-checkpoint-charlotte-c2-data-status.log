          "sourceLocations": [
            {
              "path": "internal/characters/yanfei/zz_yanfei.dm.go",
              "startLine": 90,
              "endLine": 176,
              "meaning": "charge[0..4] 的 5×15 级倍率由消耗的丹火印数选择；对应 combat1.param4..param8。"
            },
            {
              "path": "internal/characters/yanfei/zz_yanfei.dm.go",
              "startLine": 267,
              "endLine": 284,
              "meaning": "burstBonus 的 15 级增伤对应 combat3.param2；必须用独立有效 Q 天赋等级。"
            },
            {
              "path": "internal/characters/yanfei/charge.go",
              "startLine": 30,
              "endLine": 75,
              "meaning": "CA 起手确认有效丹火印、建立 A1、使用重击标签并排入一次主击；主击快照时点仍为 TODO，随后清除丹火印。"
            },
            {
              "path": "internal/characters/yanfei/asc.go",
              "startLine": 16,
              "endLine": 28,
              "meaning": "突破 >=1 时 A1 = 消耗丹火印数 × 0.05 火伤加成；新值替换旧值。"
            },
            {
              "path": "internal/characters/yanfei/asc.go",
              "startLine": 33,
              "endLine": 69,
              "meaning": "A4 要求突破 >=4、主击暴击、目标为敌人且烟绯仍在场；一次 CA 回调最多一次，0.8×ATK、火元素、重击标签、+10 帧独立快照/伤害。"
            },
            {
              "path": "internal/characters/yanfei/cons.go",
              "startLine": 13,
              "endLine": 39,
              "meaning": "C2 在目标当前生命值严格低于 50% 时，对 AttackTagExtra 加 0.20 暴击率；主击和 A4 均适用，各自命中条件应独立恢复。"
            },
            {
              "path": "internal/characters/yanfei/burst.go",
              "startLine": 31,
              "endLine": 45,
              "meaning": "Q 的 AttackTagExtra 增伤持续 15 秒；丹火印任务状态额外 1 帧并留有结束帧 TODO。"
            },
            {
              "path": "internal/characters/yanfei/yanfei.go",
              "startLine": 31,
              "endLine": 51,
              "meaning": "丹火印上限 C0–C5 为 3，C6 为 4；C1 修改体力而非伤害；burstBonus 由独立有效 Q 等级读取。"
            },
            {
              "path": "internal/characters/yanfei/yanfei.go",
              "startLine": 67,
              "endLine": 74,
              "meaning": "退场清印，但固定源码删除的 yanfeiburst 与 burst.go 的 yanfei-q 名称不一致，不能据此验证退场结束 Q 行为。"
            },
            {
              "path": "pkg/core/attack.go",
              "startLine": 36,
              "endLine": 81,
              "meaning": "QueueAttack 的 snapshotDelay 为独立快照计划；A4 不是重用主击快照。"
            }
          ],
          "scope": [
            "仅一次主动重击的自身主击及可能产生的一次 A4；命中所选单个目标。主击以 0 印作为映射基底，适配器按显式合法印数替换。",
            "主击和 A4 均为火伤、重击标签；A4 自己仍可暴击且没有递归 A4 回调。其发生概率取决于主击暴击，不得把无条件两击相加或把两击强制为同一暴击判定。",
            "主击倍率依有效普攻等级，Q 增伤依有效 Q 等级；四印只对 C6 合法。",
            "条件适配器应显式处理 A1、C2、Q 状态、A4 资格及各命中上下文。"
          ],
          "unverified": [
            "固定社区源码及 genshin-db 数表交叉一致不等于当前游戏实测验证。",
            "charge.go:59 明确主击快照时点不确定；本映射不认证帧、取消、卡肉、目标几何或完整丹火印循环。",
            "burst.go:34 对 Q 结束帧产印留有 TODO；yanfei.go:72 删除的状态名与 Q 状态名不一致，退场消除 Q 的正确生命周期不能据此认证。",
            "A4 是后续独立快照与元素附着，不能自动继承主击反应；其间状态或目标生命变化须显式恢复。",
            "不运行完整旋转、资源循环、独立随机抽样或外部模拟器。"
          ]
        },
