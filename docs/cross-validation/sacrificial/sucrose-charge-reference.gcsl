# Fixed gcsim b4ae769 source reference; one CLI invocation only.
# Three stationary targets are within the actual E circle. No aura/reactions.
# C1 supplies two initial charges; C4 and Hexerei effects are disabled.
options iteration=1 duration=34 workers=1 hitlag=false;
sucrose char lvl=1/20 cons=1 talent=1,1,1 +params=[hexerei=0,start_energy=0];
sucrose add weapon="sacrificialfragments" refine=5 lvl=1/20;
sucrose add stats cr=-0.05;
target lvl=90 resist=0.1 pos=0,2 radius=1;
target lvl=90 resist=0.1 pos=1,3 radius=1;
target lvl=90 resist=0.1 pos=-1,3 radius=1;
active sucrose;
sucrose skill;
sucrose skill;
sucrose skill;
wait(2040 - f());
