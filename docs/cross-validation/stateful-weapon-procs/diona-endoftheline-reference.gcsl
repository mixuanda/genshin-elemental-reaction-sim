# One fixed-source external invocation; no artifact sets or character damage passives.
# Observe actual frames, not a preselected successful RNG sequence.
options iteration=1 duration=20 workers=1 hitlag=false;
diona char lvl=1/20 cons=0 talent=1,1,1 +params=[start_energy=0];
diona add weapon="endoftheline" refine=5 lvl=1/20;
diona add stats cr=-0.05;
target lvl=90 resist=0.1 pos=0,2 radius=0.25;
active diona;
diona skill;
wait(160 - f());
diona attack;
wait(320 - f());
diona attack;
wait(400 - f());
diona skill;
wait(800 - f());
diona skill;
wait(960 - f());
diona attack;
wait(1120 - f());
diona attack;
wait(1200 - f());
