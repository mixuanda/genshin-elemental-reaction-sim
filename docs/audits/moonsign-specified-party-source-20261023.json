        "func NewWithWrapper(c *core.Core, w *character.CharWrapper) *Character {",
        "\tr := newChar(c)",
        "\tr.CharWrapper = w",
        "",
        "\tc.Events.SubscribeWithPhase(event.OnStellarVortexDetonate, func(args ...any) {",
        "\t\tap, ok := args[2].(*info.AttackPattern)",
        "\t\tif !ok {",
        "\t\t\treturn",
        "\t\t}",
        "\t\tif !c.Combat.Player().IsWithinArea(*ap) {",
        "\t\t\treturn",
        "\t\t}",
        "\t\tif c.Player.CurrentState() != action.JumpState {",
        "\t\t\treturn",
        "\t\t}",
